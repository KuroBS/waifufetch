#!/usr/bin/env bash

# Fast banner painter.
#
# The ONLY thing an opening terminal runs. The helper keeps paint.queue/
# full of ready banners; this script pops one, runs fastfetch once and cats
# the prepared files. When the queue is empty it advances to the next
# buffered image ON PRINT and paints it via the full path (~0.3-0.5 s, no
# network), so every terminal shows a different picture even if the helper
# is behind. It never shows a stale image.

set -uo pipefail

log="${WAIFUFETCH_LOG:-$HOME/.cache/fastfetch/waifus/paint.log}"
t0="$(date +%s%N 2>/dev/null || true)"
cache="$HOME/.cache/fastfetch/waifus"
queue="$cache/paint.queue"
path="none"

fallback() {
    exec fastfetch "$@"
}

# Nothing prepared at all: refresh the current image as blocks and show it.
fallback_fresh() {
    if [[ -x "$HOME/.local/bin/waifufetch" ]]; then
        "$HOME/.local/bin/waifufetch" --ensure-logo >/dev/null 2>&1 || true
    fi
    exec fastfetch "$@"
}

# Only paint prepared kitty banners where they can be shown. Any other
# terminal (or a LOGO_MODE that is not graphics) just runs fastfetch.
logo_conf="$(sed -nE 's/^[[:space:]]*LOGO_MODE[[:space:]]*=[[:space:]]*["'\'']?([a-z]+)["'\'']?.*/\1/p' "$HOME/.config/fastfetch/waifufetch-source.conf" 2>/dev/null | tail -n 1)"
case "${logo_conf:-auto}" in
    ansi | chafa) fallback "$@" ;;
esac
if [[ -z "${KITTY_WINDOW_ID:-}" ]]; then
    fallback "$@"
fi

state=""
if [[ -d "$queue" ]]; then
    state="$(find "$queue" -maxdepth 1 -type f -name '*.state' 2>/dev/null | sort | head -n 1)"
fi

if [[ -z "$state" || ! -r "$state" ]]; then
    # Queue empty: advance on print. Promote the next buffered image and
    # paint it right now through the full path.
    if [[ -x "$HOME/.local/bin/waifufetch" ]]; then
        exec "$HOME/.local/bin/waifufetch" "$@"
    fi
    fallback_fresh "$@"
else
    path="queue"
fi

IFS=$'\t' read -r ver image cols lines esc blank source tags_file source_file text_col pad_top hoffset < "$state" || fallback "$@"
if [[ "$ver" != "v3" ]]; then
    rm -f "$state"
    fallback "$@"
fi
[[ -s "$image" && -s "$esc" && -s "$blank" && -s "$tags_file" && -s "$source_file" ]] || { rm -f "$state"; fallback "$@"; }

# Prepared for a wider terminal than this one? Regenerate through the full
# path instead of wrapping the box or showing a stale logo.
tc_now="$(tput cols 2>/dev/null || printf '100')"
# The banner must have been prepared for a window this size: a narrower one
# wraps the box, a much wider one leaves a tiny picture next to a lot of empty
# space. The expected width is text_col + box width, and the box width is
# cached from the current config.
box_w="$(cat "$cache/box-width-v2" 2>/dev/null || printf '41')"
[[ "$box_w" =~ ^[0-9]+$ ]] || box_w=41
want=$(( text_col + box_w ))
if [[ "$tc_now" =~ ^[0-9]+$ ]] && (( want > tc_now - 1 || want < tc_now - 4 )); then
    rm -f "$state"
    if [[ -x "$HOME/.local/bin/waifufetch" ]]; then
        exec "$HOME/.local/bin/waifufetch" "$@"
    fi
    fallback "$@"
fi

export FASTFETCH_WAIFU_SOURCE="$source"
export FASTFETCH_WAIFU_TEXT_COLUMN="$text_col"

banner="$cache/banner"
mkdir -p "$banner" 2>/dev/null || true

# Publish this banner's rows BEFORE deleting the entry files; fastfetch will
# cat them and the blank logo from here. Also publish the remaining cache.
cp -f "$tags_file" "$banner/tags.txt" 2>/dev/null || true
cp -f "$source_file" "$banner/source.txt" 2>/dev/null || true
bufn="$(find "$cache/buffer" -maxdepth 1 -type f -name '*.png' 2>/dev/null | wc -l)"
bufn="${bufn:-0}"
bufsz="$(sed -nE 's/^[[:space:]]*BUFFER_SIZE[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' "$HOME/.config/fastfetch/waifu-buffer-size.conf" 2>/dev/null | head -n 1)"
printf '%s/%s\n' "$bufn" "${bufsz:-50}" > "$banner/cache.txt" 2>/dev/null || true

out="$(mktemp --tmpdir="$cache" paint.XXXXXX 2>/dev/null)" || fallback "$@"

printf '\033[2J\033[H'
# Same centring as the renderer: area = picture + the margin on both sides.
# The horizontal padding is 1 (left) + 3 (right) in config.jsonc.
total=$(( cols + 4 + box_w ))
margin=$(( (tc_now - total) / 2 ))
(( margin < 0 )) && margin=0
area=$(( cols + margin ))
fastfetch --logo "$blank" --logo-type file-raw --logo-width "$area" >"$out" 2>/dev/null
rc=$?
lines_out="$(wc -l < "$out" 2>/dev/null || printf '0')"
[[ "$lines_out" =~ ^[0-9]+$ && "$lines_out" -gt 0 ]] || lines_out="$lines"
cat "$out" 2>/dev/null
rm -f "$out" "$state" "$tags_file" "$source_file" "$blank"

printf '\033[%dA\033[1G' "$lines_out"
if [[ "${pad_top:-0}" =~ ^[0-9]+$ ]] && (( pad_top > 0 )); then
    printf '\033[%dB' "$pad_top"
fi
if [[ "${hoffset:-0}" =~ ^[0-9]+$ ]] && (( hoffset > 0 )); then
    printf '\033[%dC' "$hoffset"
fi
cat "$esc" 2>/dev/null || true
printf '\033[%d;1H' "$((lines_out + 1))"

if [[ -n "$t0" ]]; then
    t1="$(date +%s%N 2>/dev/null || true)"
    if [[ -n "$t1" ]]; then
        printf '%s path=%s ms=%s\n' "$(date +%H:%M:%S)" "$path" "$(( (t1 - t0) / 1000000 ))" >> "$log" 2>/dev/null || true
    fi
fi

exit "$rc"

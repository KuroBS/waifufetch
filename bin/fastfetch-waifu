#!/usr/bin/env bash

set -euo pipefail

CONFIG_DIR="$HOME/.config/fastfetch"
TAGS_FILE="$CONFIG_DIR/waifu-tags.conf"
AUTH_FILE="$CONFIG_DIR/danbooru-auth.conf"
GELBOORU_AUTH_FILE="$CONFIG_DIR/gelbooru-auth.conf"
SOURCE_FILE="$CONFIG_DIR/waifufetch-source.conf"
BUFFER_SIZE_FILE="$CONFIG_DIR/waifu-buffer-size.conf"
CACHE_DIR="$HOME/.cache/fastfetch/waifus"
CURRENT_IMAGE="$CACHE_DIR/current.png"
NEXT_IMAGE="$CACHE_DIR/next.png"
NEXT_URL="$CACHE_DIR/next.url"
LOCK_FILE="$CACHE_DIR/refresh.lock"
BUFFER_DIR="$CACHE_DIR/buffer"
ACTIVE_TAGS_FILE="$CACHE_DIR/active-tags.conf"
LOGO_IMAGE="$CACHE_DIR/logo.png"
LOGO_ANSI="$CACHE_DIR/logo.ansi"
LOGO_META="$CACHE_DIR/logo.meta"
KCACHE_DIR="$CACHE_DIR/kcache"
LAST_SIZE_FILE="$CACHE_DIR/last-size"
HELPER_LOCK="$CACHE_DIR/helper.lock"
PAINT_QUEUE="$CACHE_DIR/paint.queue"
FALLBACK_IMAGE="$HOME/.config/ml4w/assets/ml4w.png"
API_URL="https://danbooru.donmai.us/posts.json"
GELBOORU_API_URL="https://gelbooru.com/index.php"
BOORU_SITE="gelbooru"
USER_AGENT="fastfetch-waifu/1.0"
COMMAND_NAME="$(basename "$0")"
CURL_CONNECT_TIMEOUT=3
CURL_API_MAX_TIME=12
CURL_IMAGE_MAX_TIME=45
DEFAULT_BUFFER_SIZE=20
DEFAULT_SLIDE_DELAY=8
MIN_SLIDE_DELAY=1
MAX_SLIDE_DELAY=3600
DEFAULT_COLLAGE_TILE_COLS=24
DEFAULT_COLLAGE_TILE_LINES=12

usage() {
    cat <<'EOF'
Usage:
  fastfetch-waifu [waifu options...] [fastfetch options...]
  waifufetch [waifu options...] [fastfetch options...]
  fastfetch-waifu [waifu options...] --prefetch-buffer
  fastfetch-waifu [waifu options...] --refresh-only
  fastfetch-waifu --open-source
  fastfetch-waifu --history [COUNT|all]
  waifufetch-history [COUNT|all]
  fastfetch-waifu --slideshow [--slide-delay SECONDS]
  fastfetch-waifu --collage [COUNT]
  fastfetch-waifu --print-image
  fastfetch-waifu --buffer-count
  fastfetch-waifu --image-tags
  fastfetch-waifu --image-tags-fastfetch

Waifu options:
  -t, --tag TAGS       Cambia los tags del booru (gelbooru) y los guarda
                       Se puede repetir: --tag 1girl --tag cat_ears
  -r, --rating RATING  Cambia el rating y lo guarda: g, s, q, e o rating:g
                       (en Gelbooru se traduce a general/sensitive/questionable/explicit)
                       Usa --rating "" para borrar el rating guardado
  --buffer-size SIZE   Cambia el tamano del buffer y del historial
  --prefetch-buffer    Precarga el buffer hasta el tamano configurado y no muestra fastfetch
  --refresh-only       Alias compatible de --prefetch-buffer
  --open-source        Abre el source actual en Google Chrome
  --history [COUNT|all]
                       Muestra el historial de imagenes con tags y source
  --slideshow          Muestra solo la imagen en grande y la cambia en bucle
  --slide-delay SEC    Tiempo inicial entre imagenes en slideshow (default: 8)
  --collage [COUNT]    Muestra un collage de imagenes adaptado a la terminal
  --buffer-count       Muestra cuantas imagenes hay en el buffer
  --doctor             Diagnostico: terminal, config, logo y cache
  --ensure-logo        Genera el logo (ANSI) desde la imagen actual y sale
  --prepare-escapes    Pre-genera los escapes de las siguientes imagenes
  --prepare-next       Prepara un banner completo para el pintor rapido
  --maintain-cache     Recorta las copias mas antiguas de la cache
  --helper-start       Arranca el helper de fondo (buffer + escapes)
  --helper-stop        Para el helper de fondo
  --helper-status      Dice si el helper esta corriendo
  --image-tags         Muestra artist, copyright y characters de la imagen actual
  --image-tags-fastfetch
                       Muestra tags con filas extra alineadas para fastfetch

Examples:
  waifufetch --tag "1girl cat_ears"
  waifufetch --rating s
  waifufetch --tag "1girl cat_ears" --rating g
  waifufetch --tag "1girl" --tag "blue_hair" --rating rating:g
  waifufetch --slideshow --slide-delay 12
  waifufetch --collage
  waifufetch --collage 12

Slideshow controls:
  space  Pausa/reanuda
  n      Imagen siguiente
  + / -  Sube/baja el tiempo entre imagenes
  o      Abre el source actual
  q      Sale

Cuando usas --tag, --rating o ambos, waifufetch actualiza:
  ~/.config/fastfetch/waifu-tags.conf
Después descarga una imagen nueva y muestra fastfetch con esa imagen.

Tags:
  Edit ~/.config/fastfetch/waifu-tags.conf
  Default is SFW: 1girl rating:g
  Anonymous DANBOORU searches are limited to 2 tags; Gelbooru with an API key accepts many.

Auth:
  Create ~/.config/fastfetch/danbooru-auth.conf with:
    DANBOORU_LOGIN='your_username'
    DANBOORU_API_KEY='your_api_key'
  Then run: chmod 600 ~/.config/fastfetch/danbooru-auth.conf

waifufetch rotates through a local image buffer immediately and refills it in the background.
EOF
}

load_auth() {
    DANBOORU_LOGIN="${DANBOORU_LOGIN:-}"
    DANBOORU_API_KEY="${DANBOORU_API_KEY:-}"
    GELBOORU_API_KEY="${GELBOORU_API_KEY:-}"
    GELBOORU_USER_ID="${GELBOORU_USER_ID:-}"

    if [[ -f "$AUTH_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$AUTH_FILE"
    fi

    if [[ -f "$GELBOORU_AUTH_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$GELBOORU_AUTH_FILE"
    fi
}

load_site() {
    local site

    if [[ -f "$SOURCE_FILE" ]]; then
        site="$(sed -nE 's/^[[:space:]]*BOORU_SITE[[:space:]]*=[[:space:]]*["'\'']?([A-Za-z]+)["'\'']?.*/\1/p' "$SOURCE_FILE" | tail -n 1)"
        if [[ -n "$site" ]]; then
            BOORU_SITE="$site"
        fi
    fi

    BOORU_SITE="${BOORU_SITE:-gelbooru}"
    case "$BOORU_SITE" in
        gelbooru | danbooru) ;;
        *)
            printf 'Invalid BOORU_SITE: %s (use gelbooru or danbooru)\n' "$BOORU_SITE" >&2
            BOORU_SITE="gelbooru"
            ;;
    esac
}

# Translate rating tags between sites (danbooru uses g/s/q/e, gelbooru long names).
translate_tags_for_site() {
    local tags="$1"
    local out="" token

    for token in $tags; do
        case "$BOORU_SITE:$token" in
            gelbooru:rating:g) token="rating:general" ;;
            gelbooru:rating:s) token="rating:sensitive" ;;
            gelbooru:rating:q) token="rating:questionable" ;;
            gelbooru:rating:e) token="rating:explicit" ;;
            danbooru:rating:general) token="rating:g" ;;
            danbooru:rating:sensitive) token="rating:s" ;;
            danbooru:rating:questionable) token="rating:q" ;;
            danbooru:rating:explicit) token="rating:e" ;;
        esac
        out="${out:+$out }$token"
    done

    printf '%s\n' "${out:-1girl}"
}

gelbooru_credentials() {
    if [[ -z "${GELBOORU_API_KEY:-}" || -z "${GELBOORU_USER_ID:-}" ]]; then
        printf 'Gelbooru necesita credenciales de API.\n' >&2
        printf 'Crea %s con:\n' "$GELBOORU_AUTH_FILE" >&2
        printf "    GELBOORU_API_KEY='your_api_key'\n" >&2
        printf "    GELBOORU_USER_ID='your_user_id'\n" >&2
        printf 'Despues: chmod 600 %s\n' "$GELBOORU_AUTH_FILE" >&2
        return 1
    fi
}

# Builds a Gelbooru API url: $1 = s= section, $2 = extra query parts.
gelbooru_url() {
    local section="$1"
    local extra="${2:-}"
    local base

    base="${GELBOORU_API_URL}?page=dapi&s=${section}&q=index&json=1"
    base="${base}&api_key=$(jq -rn --arg v "$GELBOORU_API_KEY" '$v|@uri')"
    base="${base}&user_id=$(jq -rn --arg v "$GELBOORU_USER_ID" '$v|@uri')"

    if [[ -n "$extra" ]]; then
        base="${base}&${extra}"
    fi

    printf '%s\n' "$base"
}

# Gelbooru tag types: 0 general, 1 artist, 3 copyright, 4 character, 5 metadata.
# Categorizes a post's tag string into the danbooru style tags file.
write_gelbooru_post_tags() {
    local post="$1"
    local tags_output="$2"
    local tags chunk url response artist="" copyright="" characters="" post_type post_name

    tags="$(jq -r '.tags // empty' <<<"$post" 2>/dev/null || true)"

    if [[ -n "$tags" ]]; then
        chunk="$(tr ' ' '\n' <<<"$tags" | head -n 60 | tr '\n' ' ')"
        url="$(gelbooru_url tag "limit=100&names=$(jq -rn --arg v "$chunk" '$v|@uri')")"
        response="$(curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_API_MAX_TIME" -A "$USER_AGENT" "$url" 2>/dev/null || true)"

        while IFS=$'\t' read -r post_type post_name; do
            case "$post_type" in
                1) artist="${artist:+$artist }$post_name" ;;
                3) copyright="${copyright:+$copyright }$post_name" ;;
                4) characters="${characters:+$characters }$post_name" ;;
            esac
        done < <(jq -r '.tag[]? | "\(.type)\t\(.name)"' <<<"${response:-{\"tag\":[]}}" 2>/dev/null || true)
    fi

    jq -n \
        --arg artist "$artist" \
        --arg copyright "$copyright" \
        --arg characters "$characters" \
        '{artist: $artist, copyright: $copyright, characters: $characters}' > "$tags_output"
}

download_waifu_gelbooru() {
    local output="$1"
    local url_output="$2"
    local tags_output="${output%.*}.tags"
    local tags encoded url response count index post image_url post_id post_url tmp

    mkdir -p "$CACHE_DIR"
    load_auth
    load_site
    gelbooru_credentials || return 1

    tags="$(translate_tags_for_site "$(build_tags)")"
    encoded="$(jq -rn --arg v "$tags" '$v|@uri')"
    url="$(gelbooru_url post "limit=100&tags=${encoded}+sort%3Arandom")"

    response="$(curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_API_MAX_TIME" -A "$USER_AGENT" "$url" 2>/dev/null)" || return 1

    count="$(jq -r '[.post[]? | select((.file_url // "") != "" and ((.file_url | test("\\.(jpe?g|png|gif|webp)$"; "i"))))] | length' <<<"$response" 2>/dev/null || printf '0')"
    if [[ ! "$count" =~ ^[0-9]+$ || "$count" -lt 1 ]]; then
        return 1
    fi

    index=$((RANDOM % count))
    post="$(jq -c --argjson i "$index" '[.post[]? | select((.file_url // "") != "" and ((.file_url | test("\\.(jpe?g|png|gif|webp)$"; "i"))))][$i]' <<<"$response")"
    image_url="$(jq -r '.file_url // empty' <<<"$post")"
    post_id="$(jq -r '.id // empty' <<<"$post")"

    if [[ -z "$image_url" || -z "$post_id" ]]; then
        return 1
    fi

    post_url="https://gelbooru.com/index.php?page=post&s=view&id=${post_id}"

    tmp="$(mktemp --tmpdir="$CACHE_DIR" waifu.XXXXXX)"
    if ! curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_IMAGE_MAX_TIME" -A "$USER_AGENT" -H "Referer: ${GELBOORU_API_URL}/" "$image_url" -o "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if ! magick "$tmp[0]" -auto-orient -resize '1050x1050>' "$output"; then
        rm -f "$tmp"
        return 1
    fi
    printf '%s\n' "$post_url" > "$url_output"
    write_gelbooru_post_tags "$post" "$tags_output"
    rm -f "$tmp"
}

read_tags() {
    if [[ -f "$TAGS_FILE" ]]; then
        sed -e 's/#.*$//' -e '/^[[:space:]]*$/d' "$TAGS_FILE" | tr '\n' ' ' | sed 's/[[:space:]]*$//'
    else
        printf '%s\n' "1girl rating:g"
    fi
}

read_buffer_size() {
    local size

    if [[ -f "$BUFFER_SIZE_FILE" ]]; then
        size="$(sed -n 's/^[[:space:]]*BUFFER_SIZE[[:space:]]*=[[:space:]]*//p' "$BUFFER_SIZE_FILE" | tail -n 1)"
        size="${size:-$(sed -e 's/#.*$//' -e '/^[[:space:]]*$/d' "$BUFFER_SIZE_FILE" | tail -n 1)}"
    else
        size="$DEFAULT_BUFFER_SIZE"
    fi

    if [[ "$size" =~ ^[0-9]+$ && "$size" -ge 1 && "$size" -le 100 ]]; then
        printf '%s\n' "$size"
    else
        printf '%s\n' "$DEFAULT_BUFFER_SIZE"
    fi
}

normalize_buffer_size() {
    local size="$1"

    if [[ "$size" =~ ^[0-9]+$ && "$size" -ge 1 && "$size" -le 100 ]]; then
        printf '%s\n' "$size"
    else
        printf 'Invalid buffer size: %s\n' "$size" >&2
        printf 'Use a number from 1 to 100.\n' >&2
        exit 2
    fi
}

save_buffer_size() {
    local size="$1"

    size="$(normalize_buffer_size "$size")"
    mkdir -p "$CONFIG_DIR"
    printf 'BUFFER_SIZE=%s\n' "$size" > "$BUFFER_SIZE_FILE"
    BUFFER_SIZE="$size"
}

strip_rating_tags() {
    local tags="$1"

    sed -E 's/(^|[[:space:]])rating:[^[:space:]]+//g; s/^[[:space:]]+//; s/[[:space:]]+$//' <<<"$tags"
}

last_rating_tag() {
    local tags="$1"

    { grep -Eo '(^|[[:space:]])rating:[^[:space:]]+' <<<"$tags" || true; } | sed 's/^[[:space:]]*//' | tail -n 1
}

normalize_rating() {
    local rating="$1"

    rating="${rating#rating:}"
    case "$rating" in
        g|s|q|e)
            printf 'rating:%s\n' "$rating"
            ;;
        general|sensitive|questionable|explicit)
            printf 'rating:%s\n' "$rating"
            ;;
        *)
            printf 'Invalid rating: %s\n' "$1" >&2
            printf 'Use one of: g, s, q, e, rating:g, rating:s, rating:q, rating:e\n' >&2
            exit 2
            ;;
    esac
}

build_tags() {
    local config_tags config_rating tags rating

    config_tags="$(read_tags)"

    if [[ -n "${TAG_OVERRIDE:-}" ]]; then
        tags="$TAG_OVERRIDE"
        config_rating="$(last_rating_tag "$config_tags")"
        if [[ -z "$config_rating" ]]; then
            config_rating="rating:g"
        fi
        if [[ "$tags" != *rating:* && -n "$config_rating" ]]; then
            tags="$tags $config_rating"
        fi
    else
        tags="$config_tags"
    fi

    if [[ -z "$tags" ]]; then
        tags="1girl rating:g"
    fi

    if [[ "${RATING_OVERRIDE_SET:-0}" -eq 1 ]]; then
        tags="$(strip_rating_tags "$tags")"
        if [[ -n "${RATING_OVERRIDE:-}" ]]; then
            rating="$(normalize_rating "$RATING_OVERRIDE")"
            tags="${tags:+$tags }$rating"
        fi
    fi

    printf '%s\n' "$tags"
}

save_tags() {
    local tags

    tags="$(build_tags)"
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$tags" > "$TAGS_FILE"
}

temp_png() {
    local prefix="$1"
    local tmp

    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    tmp="$(mktemp --tmpdir="$CACHE_DIR" "${prefix}.XXXXXX.png" 2>/dev/null || true)"
    if [[ -z "$tmp" ]]; then
        tmp="$(mktemp --tmpdir="${TMPDIR:-/tmp}" "${prefix}.XXXXXX.png")"
    fi

    printf '%s\n' "$tmp"
}

mark_active_tags() {
    mkdir -p "$CACHE_DIR"
    read_tags > "$ACTIVE_TAGS_FILE"
}

warn_fetch_failed() {
    printf 'waifufetch: no se pudo descargar de %s (API caida o sin red). Usando imagen cacheada.\n' "$BOORU_SITE" >&2
}

# Render an image as truecolor half-block ANSI art.
#
# fastfetch can only draw image logos itself when libchafa.so (the optional
# "chafa" dependency) is installed; when it is missing fastfetch silently
# falls back to the distro ASCII logo. Rendering the blocks here removes that
# dependency completely: any terminal with 24-bit color shows the picture.
render_ansi_logo() {
    local image="$1"
    local out="$2"
    local cols="${3:-33}"
    local max_lines="${4:-22}"

    [[ -s "$image" ]] || return 1

    magick "$image[0]" -auto-orient -background '#101010' -alpha remove -alpha off \
        -filter Lanczos -resize "${cols}x$((max_lines * 2))" \
        -unsharp 0x0.6+0.4+0.01 -depth 8 txt:- 2>/dev/null \
        | sed -nE 's/^([0-9]+),([0-9]+): \(([0-9]+),([0-9]+),([0-9]+).*/\1 \2 \3 \4 \5/p' \
        | awk -v block="▀" -v widthfile="$out.width" '
            BEGIN { esc = sprintf("%c", 27) }
            NF == 5 {
                key = $2 "," $1
                R[key] = $3; G[key] = $4; B[key] = $5
                if ($1 > maxx) maxx = $1
                if ($2 > maxy) maxy = $2
            }
            END {
                for (line = 0; line <= int(maxy / 2); line++) {
                    y1 = line * 2; y2 = y1 + 1; buf = ""
                    for (x = 0; x <= maxx; x++) {
                        k1 = y1 "," x
                        buf = buf esc "[38;2;" R[k1] ";" G[k1] ";" B[k1] "m"
                        if (y2 <= maxy) {
                            k2 = y2 "," x
                            buf = buf esc "[48;2;" R[k2] ";" G[k2] ";" B[k2] "m"
                        }
                        buf = buf block
                    }
                    printf "%s%s[0m\n", buf, esc
                }
                if (widthfile != "") {
                    printf "%d\n", maxx + 1 > widthfile
                    close(widthfile)
                }
            }' > "$out"

    [[ -s "$out" ]]
}

logo_columns() {
    local width

    width="$(sed -nE 's/^[[:space:]]*"width"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" 2>/dev/null | head -n 1)"

    if [[ "$width" =~ ^[0-9]+$ && "$width" -ge 8 ]]; then
        printf '%s\n' "$width"
    else
        printf '33\n'
    fi
}

# Longest tag in a tags listing ("artist: a b"), in characters.
tag_max_len() {
    local tags="$1" line value token max=0

    while IFS= read -r line; do
        value="${line#*: }"
        for token in $value; do
            if (( ${#token} > max )); then
                max=${#token}
            fi
        done
    done <<<"$tags"

    printf '%s\n' "$max"
}

# Columns fastfetch puts in front of the module box for a logo $1 cells wide.
# Measured: the logo area is max(content, config width - 1) plus the paddings,
# so a narrow picture does not pull the box to the left.
text_column_for_width() {
    local logo_w="$1" width left top right

    width="$(logo_columns)"
    read -r left _ right < <(logo_padding)
    (( logo_w < width - 1 )) && logo_w=$((width - 1))

    printf '%s\n' "$((logo_w + left + right))"
}

# Widest the logo may get so the module box (prefix + longest tag) still fits
# on one line. Without this a long tag name wraps onto the next row.
tag_width_cap() {
    local tags="$1" tcols pad_left pad_top pad_right cap

    read -r tcols _ < <(terminal_cells 2>/dev/null || printf '100 30\n')
    [[ "$tcols" =~ ^[0-9]+$ ]] || tcols=100
    read -r pad_left _ pad_right < <(logo_padding)

    # Leave ~60 columns for the box: 16 for the "| <icon> label| " prefix plus
    # the longest built-in value (the cpu line is the widest, ~43 chars).
    # Tag labels are truncated to whatever is left over.
    cap=$((tcols - pad_left - pad_right - 60))
    (( cap < 20 )) && cap=20

    printf '%s\n' "$cap"
}

# Largest logo that fits next to the module box in the current terminal.
# Prints "<columns> <lines>".
logo_geometry() {
    local cfg_cols tcols tlines box avail_cols avail_lines

    cfg_cols="$(logo_columns)"
    read -r tcols tlines < <(terminal_cells 2>/dev/null || printf '100 30\n')
    [[ "$tcols" =~ ^[0-9]+$ ]] || tcols=100
    [[ "$tlines" =~ ^[0-9]+$ ]] || tlines=30

    box="$(fastfetch_text_column)"
    avail_cols=$((tcols - box - 2))
    avail_lines=$((tlines - 1))

    (( avail_cols < cfg_cols )) && avail_cols="$cfg_cols"
    (( avail_cols < 20 )) && avail_cols=20
    (( avail_cols > 120 )) && avail_cols=120
    if [[ "${LOGO_MAX_COLS:-}" =~ ^[0-9]+$ ]] && (( avail_cols > LOGO_MAX_COLS )); then
        avail_cols="$LOGO_MAX_COLS"
    fi
    (( avail_lines < 8 )) && avail_lines=8
    (( avail_lines > 60 )) && avail_lines=60

    printf '%s %s\n' "$avail_cols" "$avail_lines"
}

# "ansi" (blocks, works everywhere), "chafa" (needs the chafa package) or
# "graphics" (real pixels through kitty's image protocol). "auto" picks
# graphics inside kitty and ansi anywhere else.
logo_mode() {
    local mode

    if [[ -n "${WAIFUFETCH_LOGO_MODE:-}" ]]; then
        printf '%s\n' "$WAIFUFETCH_LOGO_MODE"
        return 0
    fi

    mode="$(sed -nE 's/^[[:space:]]*LOGO_MODE[[:space:]]*=[[:space:]]*["'\'']?([a-z]+)["'\'']?.*/\1/p' "$SOURCE_FILE" 2>/dev/null | tail -n 1)"

    case "${mode:-auto}" in
        graphics | chafa | ansi) printf '%s\n' "$mode" ;;
        *)
            # NOTE: no [[ -t 1 ]] here - this runs in a command substitution
            # where stdout is a pipe; the real tty check lives in the caller.
            if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
                printf 'graphics\n'
            else
                printf 'ansi\n'
            fi
            ;;
    esac
}

# Pixel size of one character cell, "<w> <h>".
cell_pixels() {
    local size w h tcols tlines cw ch cache_file

    read -r tcols tlines < <(terminal_cells 2>/dev/null || printf '100 30\n')

    # kitten is a python process (~140ms); the cell size only changes when the
    # window or font size does, so cache it per terminal size.
    cache_file="$CACHE_DIR/cell-size.${tcols}x${tlines}"
    if [[ -s "$cache_file" ]]; then
        read -r cw ch < "$cache_file"
        if [[ "$cw" =~ ^[0-9]+$ && "$ch" =~ ^[0-9]+$ && "$cw" -gt 0 && "$ch" -gt 0 ]]; then
            printf '%s %s\n' "$cw" "$ch"
            return 0
        fi
    fi

    size="$(kitten icat --print-window-size --stdin=no 2>/dev/null | tr -d '\r' | head -n 1)"

    if [[ "$size" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        w="${BASH_REMATCH[1]}"
        h="${BASH_REMATCH[2]}"
        if [[ "$tcols" =~ ^[0-9]+$ && "$tcols" -gt 0 && "$tlines" =~ ^[0-9]+$ && "$tlines" -gt 0 ]]; then
            cw=$((w / tcols))
            ch=$((h / tlines))
        fi
    fi

    [[ "$cw" =~ ^[0-9]+$ && "$cw" -gt 0 ]] || cw=8
    [[ "$ch" =~ ^[0-9]+$ && "$ch" -gt 0 ]] || ch=17

    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    printf '%s %s\n' "$cw" "$ch" > "$cache_file" 2>/dev/null || true
    printf '%s %s\n' "$cw" "$ch"
}

# Left/top logo padding from config.jsonc, "<left> <top>".
logo_padding() {
    local left top right

    left="$(sed -nE 's/^[[:space:]]*"left"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" 2>/dev/null | head -n 1)"
    top="$(sed -nE 's/^[[:space:]]*"top"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" 2>/dev/null | head -n 1)"
    right="$(sed -nE 's/^[[:space:]]*"right"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" 2>/dev/null | head -n 1)"

    printf '%s %s %s\n' "${left:-0}" "${top:-0}" "${right:-0}"
}

# Cell rectangle "<cols> <lines>" that keeps the image aspect inside the area
# left free by the module box.
graphics_geometry() {
    local image="$1" maxc maxl iw ih cw ch x y pad_left pad_top

    read -r maxc maxl < <(logo_geometry)
    read -r pad_left pad_top _ < <(logo_padding)
    maxl=$((maxl - pad_top))
    ((maxl < 4)) && maxl=4

    # Image dimensions are cached next to the image: spawning ImageMagick on
    # every terminal open costs ~40ms and they never change.
    local dim_file="${image%.*}.dim"
    iw=""
    ih=""
    if [[ -s "$dim_file" ]]; then
        read -r iw ih < "$dim_file"
    fi
    if [[ ! "$iw" =~ ^[0-9]+$ || ! "$ih" =~ ^[0-9]+$ ]]; then
        # A corrupt download makes identify fail; read then fails too and
        # set -e would abort the whole run.
        read -r iw ih < <(magick identify -format '%w %h\n' "$image[0]" 2>/dev/null | head -n 1) || true
        if [[ "$iw" =~ ^[0-9]+$ && "$ih" =~ ^[0-9]+$ ]]; then
            printf '%s %s\n' "$iw" "$ih" > "$dim_file" 2>/dev/null || true
        fi
    fi

    if [[ "$iw" =~ ^[0-9]+$ && "$ih" =~ ^[0-9]+$ && "$iw" -gt 0 && "$ih" -gt 0 ]]; then
        read -r cw ch < <(cell_pixels)
        x="$maxc"
        y=$((x * cw * ih / (ch * iw)))
        if ((y > maxl)); then
            y="$maxl"
            x=$((y * ch * iw / (cw * ih)))
        fi
    else
        x="$maxc"
        y="$maxl"
    fi

    ((x < 8)) && x=8
    ((y < 4)) && y=4

    printf '%s %s\n' "$x" "$y"
}

# Emit the kitty graphics-protocol escape that draws $1 scaled to $2 x $3
# cells (C=1 keeps the cursor in place). We emit it ourselves on stdout so the
# ordering with fastfetch is deterministic - kitten icat writes to /dev/tty
# instead, which races with fastfetch's stdout.
kitty_image_escape() {
    local image="$1" cols="$2" lines="$3"
    local img cw ch pw ph tmp rc

    [[ -s "$image" ]] || return 1
    command -v python3 >/dev/null 2>&1 || return 1

    # Sending a 750 KB PNG for a 40x28 cell area wastes transfer and decode
    # time. Downscale to exactly what the terminal can show.
    img="$image"
    read -r cw ch < <(cell_pixels)
    if command -v magick >/dev/null 2>&1; then
        pw=$((cols * cw))
        ph=$((lines * ch))
        if (( pw > 0 && ph > 0 )); then
            tmp="$(temp_png kimg)"
            if magick "$image[0]" -auto-orient -resize "${pw}x${ph}" -depth 8 "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
                img="$tmp"
            else
                rm -f "$tmp"
            fi
        fi
    fi

    python3 - "$img" "$cols" "$lines" <<'PYEOF'
import base64, sys
img, c, r = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
data = base64.b64encode(open(img, "rb").read()).decode()
esc = "\033"
CH = 4096
for i in range(0, len(data), CH):
    chunk = data[i:i+CH]
    more = 0 if i + CH >= len(data) else 1
    if i == 0:
        sys.stdout.write(f"{esc}_Ga=T,f=100,t=d,c={c},r={r},q=2,C=1,m={more};{chunk}{esc}\\")
    else:
        sys.stdout.write(f"{esc}_Gm={more};{chunk}{esc}\\")
sys.stdout.flush()
PYEOF
    rc=$?
    [[ "$img" == "$image" ]] || rm -f "$img"
    return $rc
}

# Cache file for the escape of one image at one geometry.
escape_cache_file() {
    local image="$1" cols="$2" lines="$3"

    printf '%s/%s.%sx%s.esc\n' "$KCACHE_DIR" "$(basename "$image")" "$cols" "$lines"
}

# Emit the kitty escape, reusing the cached one when possible. A cached escape
# is just a cat, which is what makes opening a terminal feel instant.
kitty_image_escape_cached() {
    local image="$1" cols="$2" lines="$3"
    local cache tmp

    [[ -s "$image" ]] || return 1
    cache="$(escape_cache_file "$image" "$cols" "$lines")"

    if [[ -s "$cache" ]]; then
        cat "$cache"
        return 0
    fi

    mkdir -p "$KCACHE_DIR" 2>/dev/null || true
    tmp="$cache.tmp.$$"
    if kitty_image_escape "$image" "$cols" "$lines" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$cache" 2>/dev/null || true
        cat "$cache"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Keep the buffer at its configured size, dropping the newest surplus so the
# rotation order (oldest first) is preserved.
# Sliding-window cleanup: every time an image is shown or downloaded, the
# oldest copies of each kind are evicted so the cache never grows unbounded.
maintain_cache() {
    local current_target old

    # Shown-image history: keep the newest 20 (the filename carries the
    # promotion time, so sorting by name is promotion order). Never remove
    # the image the current logo points at.
    current_target="$(readlink -f "$CURRENT_IMAGE" 2>/dev/null || true)"
    find "$CACHE_DIR" -maxdepth 1 -type f -name 'current-*.png' 2>/dev/null \
        | sort -r \
        | awk -v keep="${WAIFUFETCH_HISTORY_KEEP:-20}" 'NR > keep {print}' \
        | while IFS= read -r old; do
            if [[ -n "$current_target" && "$old" == "$current_target" ]]; then
                continue
            fi
            rm -f "$old" "${old%.*}.url" "${old%.*}.tags" "${old%.*}.dim"
        done

    # Pre-rendered kitty escapes: keep the newest 40.
    ls -1t "$KCACHE_DIR"/*.esc 2>/dev/null | tail -n +41 | xargs -r rm -f 2>/dev/null || true

    # Buffer: drop PNGs whose download was interrupted (no .url sidecar).
    while IFS= read -r p; do
        [[ -s "${p%.*}.url" ]] || rm -f "$p"
    done < <(find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' 2>/dev/null || true)

    # Buffer: cap at BUFFER_SIZE (drop the newest surplus so the
    # oldest-first rotation order is preserved).
    prune_buffer

    # Queue leftovers: entry files whose .state was consumed or failed.
    find "$PAINT_QUEUE" -maxdepth 1 -type f ! -name '*.state' -mmin +60 -delete 2>/dev/null || true

    return 0
}

prune_buffer() {
    local count

    [[ -d "$BUFFER_DIR" ]] || return 0
    count="$(find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' 2>/dev/null | wc -l)"
    count="${count:-0}"
    (( count > BUFFER_SIZE )) || return 0

    find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null \
        | sort -n \
        | tail -n +$((BUFFER_SIZE + 1)) \
        | cut -d' ' -f2- \
        | while IFS= read -r extra; do
            rm -f "$extra" "${extra%.*}.url" "${extra%.*}.tags" "${extra%.*}.dim"
        done
}

oldest_buffer_image() {
    find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null \
        | sort -n | head -n 1 | cut -d' ' -f2-
}

# Prepare the escape for the image the next terminal will show, so that the
# next startup only has to cat a file. Runs in the background.
prefetch_escape_async() {
    (
        local img cols lines
        img="$(oldest_buffer_image)"
        if [[ -n "$img" && -s "$img" ]]; then
            read -r cols lines < <(graphics_geometry "$img")
            kitty_image_escape_cached "$img" "$cols" "$lines" >/dev/null 2>&1 || true
        fi
        ls -1t "$KCACHE_DIR"/*.esc 2>/dev/null | tail -n +41 | xargs -r rm -f 2>/dev/null || true
    ) >/dev/null 2>&1 &
    renice -n 10 -p "$!" >/dev/null 2>&1 || true
}

# Fastfetch layout with a blank logo area, then the real image drawn on top
# with kitty's image protocol (full resolution, no block approximation).
graphics_banner() {
    local image="$1"
    local cols lines blank args lines_out rc pad_left pad_top pad_right out_file maxc hoffset

    read -r pad_left pad_top pad_right < <(logo_padding)
    read -r cols lines < <(graphics_geometry "$image")
    blank="$CACHE_DIR/logo-blank.txt"
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    awk -v n="$lines" -v w="$cols" 'BEGIN { s = ""; for (i = 0; i < w; i++) s = s " "; for (j = 0; j < n; j++) print s }' > "$blank" 2>/dev/null || return 1

    args=(--logo "$blank" --logo-type file-raw)

    # The tag rows are printed by a child process that indents continuation
    # lines with a cursor-forward escape; it needs the real logo width or the
    # copyright/character lines end up inside the picture area.
    export FASTFETCH_WAIFU_TEXT_COLUMN="$(text_column_for_width "$cols")"
    write_banner_files

    # Single fastfetch pass: capture it to a temp file to learn the exact line
    # count for the cursor maths, then print it. Running fastfetch a second
    # time just to count lines doubled the cost of opening a terminal.
    out_file="$(temp_png banner)"
    printf '\033[2J\033[H'
    fastfetch "${args[@]}" "${FASTFETCH_ARGS[@]}" > "$out_file" 2>/dev/null
    rc=$?
    lines_out="$(wc -l < "$out_file" 2>/dev/null || printf '0')"
    [[ "$lines_out" =~ ^[0-9]+$ && "$lines_out" -gt 0 ]] || lines_out="$lines"
    cat "$out_file" 2>/dev/null || true
    rm -f "$out_file"

    # Top-left of the logo area (row 1 + padding).
    printf '\033[%dA\033[1G' "$lines_out"
    if (( pad_top )); then printf '\033[%dB' "$pad_top"; fi

    # Centre the picture in the free space: a portrait image is narrower than
    # the area, and without this it would hug the left edge with a big gap.
    read -r maxc _ < <(logo_geometry)
    hoffset=$(( pad_left + (maxc - cols) / 2 ))
    (( hoffset < pad_left )) && hoffset="$pad_left"
    if (( hoffset )); then printf '\033[%dC' "$hoffset"; fi

    if ! kitty_image_escape_cached "$image" "$cols" "$lines"; then
        printf '\033[%d;1H' "$((lines_out + 1))"
        return 1
    fi

    # Cursor just below the banner for the shell prompt.
    printf '\033[%d;1H' "$((lines_out + 1))"
    return "$rc"
}

# Print an image as ANSI art (history previews, slideshow, collage).
record_terminal_size() {
    local cols lines

    [[ -t 1 ]] || return 0
    read -r cols lines < <(terminal_cells 2>/dev/null || true)
    [[ "$cols" =~ ^[0-9]+$ && "$lines" =~ ^[0-9]+$ ]] || return 0
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    printf '%s %s\n' "$cols" "$lines" > "$LAST_SIZE_FILE" 2>/dev/null || true
}

# Pre-render the escapes for the next buffered images, using the geometry of
# the last real terminal. This is what makes opening a terminal a plain cat.
prepare_escapes() {
    local limit="${1:-8}" img cols lines prepared=0

    [[ -d "$BUFFER_DIR" ]] || return 0
    [[ "$(logo_mode)" == "graphics" ]] || return 0
    mkdir -p "$KCACHE_DIR" 2>/dev/null || true

    while IFS= read -r img; do
        [[ -s "$img" ]] || continue
        if (( prepared >= limit )); then
            break
        fi
        read -r cols lines < <(graphics_geometry "$img")
        kitty_image_escape_cached "$img" "$cols" "$lines" >/dev/null 2>&1 || true
        prepared=$((prepared + 1))
    done < <(
        find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null \
            | sort -n | cut -d' ' -f2- || true
    )

    ls -1t "$KCACHE_DIR"/*.esc 2>/dev/null | tail -n +41 | xargs -r rm -f 2>/dev/null || true
    return 0
}

# Prepare everything the fast painter needs for one banner and park it in the
# queue: the image, its pre-rendered escape, the blank logo and the env the
# tag rows need. The painter then only runs fastfetch and cats files.
prepare_next_banner() {
    local image cols lines blank escf source tags text_col pad_left pad_top pad_right maxc hoffset n entry

    read -r pad_left pad_top pad_right < <(logo_padding)
    [[ "$(logo_mode)" == "graphics" ]] || return 1

    mkdir -p "$PAINT_QUEUE" 2>/dev/null || true
    n="$(ls -1 "$PAINT_QUEUE"/*.state 2>/dev/null | wc -l)"
    n="${n:-0}"
    (( n >= 3 )) && return 0

    # Another image, if there is one buffered; keep the current otherwise.
    if ! promote_buffer_image >/dev/null 2>&1; then
        # Buffer empty: fetch one so the queue keeps rotating instead of
        # repeating the same picture for every entry.
        WAIFUFETCH_FILL_LIMIT=1 fill_buffer >/dev/null 2>&1 || true
        promote_buffer_image >/dev/null 2>&1 || true
    fi
    image="$(choose_logo)"
    [[ -s "$image" ]] || return 1

    # The width cap (room for the module box) is normally computed in the
    # main flow; --prepare-next exits early, so apply it here too, otherwise
    # a landscape picture fills the whole width and the banner wraps.
    source="$(post_url_for_logo "$image")"
    tags="$(tags_for_logo "$image")"
    LOGO_MAX_COLS="$(tag_width_cap "$tags")"

    read -r cols lines < <(graphics_geometry "$image")
    read -r maxc _ < <(logo_geometry)
    hoffset=$(( pad_left + (maxc - cols) / 2 ))
    (( hoffset < pad_left )) && hoffset="$pad_left"
    entry="$PAINT_QUEUE/$(date +%s%N)"

    # Per-entry blank file: a shared one would be clobbered by the next
    # prepared banner and misalign the box of this one.
    blank="$entry.blank"
    awk -v n="$lines" -v w="$cols" 'BEGIN { s = ""; for (i = 0; i < w; i++) s = s " "; for (j = 0; j < n; j++) print s }' > "$blank" 2>/dev/null || return 1

    escf="$(escape_cache_file "$image" "$cols" "$lines")"
    kitty_image_escape_cached "$image" "$cols" "$lines" >/dev/null 2>&1 || return 1

    text_col="$(text_column_for_width "$cols")"

    # Tags carry newlines, so they cannot live in the single-line state file:
    # pre-format them into per-entry files the painter copies into place.
    if ! FASTFETCH_WAIFU_TAGS="$tags" \
         FASTFETCH_WAIFU_SOURCE="$source" \
         FASTFETCH_WAIFU_TEXT_COLUMN="$text_col" \
         "$HOME/.local/bin/waifufetch-banner-files" "$entry.tags" "$entry.source" >/dev/null 2>&1; then
        return 1
    fi
    [[ -s "$entry.tags" ]] || return 1

    # Write atomically so the painter never reads a half-written state while
    # the helper is preparing it (a partial line used to force the slow
    # fallback path).
    printf 'v2\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$image" "$cols" "$lines" "$escf" "$blank" "$source" \
        "$entry.tags" "$entry.source" "$text_col" "$pad_top" "$hoffset" \
        > "$entry.state.tmp" 2>/dev/null || return 1
    mv -f "$entry.state.tmp" "$entry.state" 2>/dev/null || return 1

    maintain_cache
    return 0
}

helper_running() {
    [[ -e "$HELPER_LOCK" ]] || return 1
    { exec 7>>"$HELPER_LOCK"; } 2>/dev/null || return 1
    if flock -n 7; then
        exec 7>&-
        return 1
    fi
    exec 7>&-
    return 0
}

start_helper() {
    local helper="$HOME/.local/bin/waifufetch-helper"

    command -v helper >/dev/null 2>&1 || true
    [[ -x "$helper" ]] || return 0
    helper_running && return 0

    # Double-fork: the helper becomes a child of init, so it neither blocks
    # nor is accounted as part of the caller's job.
    (
        if command -v setsid >/dev/null 2>&1; then
            setsid "$helper" >/dev/null 2>&1 </dev/null &
        else
            nohup "$helper" >/dev/null 2>&1 </dev/null &
        fi
    ) 2>/dev/null &
    disown 2>/dev/null || true
    return 0
}

stop_helper() {
    local pid
    [[ -e "$HELPER_LOCK" ]] || return 0
    pid="$(cat "$HELPER_LOCK.pid" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && grep -qa waifufetch-helper "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$HELPER_LOCK.pid"
    return 0
}

write_banner_files() {
    local writer="$HOME/.local/bin/waifufetch-banner-files"

    [[ -x "$writer" ]] || return 0
    "$writer" >/dev/null 2>&1 || true
    return 0
}

show_ansi_image() {
    local image="$1"
    local width="${2:-}"
    local cols tmp

    if [[ -z "$width" ]]; then
        cols="$(terminal_cells 2>/dev/null | cut -d' ' -f1)"
        width="${cols:-80}"
    fi
    if [[ ! "$width" =~ ^[0-9]+$ || "$width" -lt 8 ]]; then
        width=80
    fi

    tmp="$(temp_png ansi)"
    if ! render_ansi_logo "$image" "$tmp" "$width" 200; then
        rm -f "$tmp"
        return 1
    fi

    cat "$tmp"
    rm -f "$tmp"
}

tags_config_changed() {
    local current_tags active_tags

    current_tags="$(read_tags)"
    if [[ -f "$ACTIVE_TAGS_FILE" ]]; then
        active_tags="$(cat "$ACTIVE_TAGS_FILE")"
    else
        active_tags=""
    fi

    [[ "$current_tags" != "$active_tags" ]]
}

write_post_tags() {
    local post="$1"
    local tags_output="$2"
    local artist_tags copyright_tags character_tags

    artist_tags="$(jq -r '.tag_string_artist // empty' <<<"$post")"
    copyright_tags="$(jq -r '.tag_string_copyright // empty' <<<"$post")"
    character_tags="$(jq -r '.tag_string_character // empty' <<<"$post")"

    jq -n \
        --arg artist "$artist_tags" \
        --arg copyright "$copyright_tags" \
        --arg characters "$character_tags" \
        '{artist: $artist, copyright: $copyright, characters: $characters}' > "$tags_output"
}

fetch_tags_for_logo() {
    local logo="$1"
    local url_file="${logo%.*}.url"
    local tags_file="${logo%.*}.tags"
    local post_url post_id url post

    if [[ -s "$tags_file" ]] && jq -e 'has("copyright")' "$tags_file" >/dev/null 2>&1; then
        return 0
    fi

    if [[ ! -s "$url_file" ]]; then
        return 0
    fi

    post_url="$(cat "$url_file")"
    load_site
    if [[ "$BOORU_SITE" == "gelbooru" ]]; then
        post_id="$(sed -nE 's#^.*[?&]id=([0-9]+).*#\1#p' <<<"$post_url")"
    else
        post_id="$(sed -nE 's#^.*/posts/([0-9]+).*#\1#p' <<<"$post_url")"
    fi
    if [[ -z "$post_id" ]]; then
        return 1
    fi

    load_auth
    if [[ "$BOORU_SITE" == "gelbooru" ]]; then
        url="$(gelbooru_url post "id=${post_id}")"
        post="$(curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_API_MAX_TIME" -A "$USER_AGENT" "$url" 2>/dev/null)" || return 1
        write_gelbooru_post_tags "$(jq -c '(.post | if type == "array" then (.[0] // empty) else . end) // empty' <<<"$post")" "$tags_file"
        return 0
    fi

    url="https://danbooru.donmai.us/posts/${post_id}.json"
    if [[ -n "${DANBOORU_LOGIN:-}" && -n "${DANBOORU_API_KEY:-}" ]]; then
        url="${url}?login=$(jq -rn --arg v "$DANBOORU_LOGIN" '$v|@uri')&api_key=$(jq -rn --arg v "$DANBOORU_API_KEY" '$v|@uri')"
    fi

    post="$(curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_API_MAX_TIME" -A "$USER_AGENT" "$url" 2>/dev/null)" || return 1
    write_post_tags "$post" "$tags_file"
}

download_waifu() {
    local output="${1:-$CURRENT_IMAGE}"
    local url_output="${2:-${output%.*}.url}"
    local tags_output="${output%.*}.tags"
    local tags encoded response post image_url post_id post_url tmp url

    load_site
    if [[ "$BOORU_SITE" == "gelbooru" ]]; then
        download_waifu_gelbooru "$output" "$url_output"
        return $?
    fi

    mkdir -p "$CACHE_DIR"
    load_auth
    tags="$(build_tags)"

    encoded="$(jq -rn --arg tags "$tags" '$tags|@uri')"
    url="${API_URL}?limit=20&random=true&tags=${encoded}"
    if [[ -n "${DANBOORU_LOGIN:-}" && -n "${DANBOORU_API_KEY:-}" ]]; then
        url="${url}&login=$(jq -rn --arg v "$DANBOORU_LOGIN" '$v|@uri')&api_key=$(jq -rn --arg v "$DANBOORU_API_KEY" '$v|@uri')"
    fi

    response="$(curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_API_MAX_TIME" -A "$USER_AGENT" "$url")" || return 1
    post="$(jq -c '
        [.[] | select(
            (.file_url // "") != "" and
            (.file_ext | IN("jpg", "jpeg", "png", "webp", "gif"))
        )][0] // empty
    ' <<<"$response")"
    image_url="$(jq -r '.large_file_url // .file_url // empty' <<<"$post")"
    post_id="$(jq -r '.id // empty' <<<"$post")"

    if [[ -z "$image_url" || -z "$post_id" ]]; then
        return 1
    fi
    post_url="https://danbooru.donmai.us/posts/${post_id}"

    tmp="$(mktemp --tmpdir="$CACHE_DIR" waifu.XXXXXX)"
    if ! curl -fsSL --compressed --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_IMAGE_MAX_TIME" -A "$USER_AGENT" "$image_url" -o "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if ! magick "$tmp[0]" -auto-orient -resize '1050x1050>' "$output"; then
        rm -f "$tmp"
        return 1
    fi
    printf '%s\n' "$post_url" > "$url_output"
    write_post_tags "$post" "$tags_output"
    rm -f "$tmp"
}

cleanup_cache() {
    local current_target old_image

    find "$CACHE_DIR" -maxdepth 1 -type f -name 'waifu.*' -delete 2>/dev/null || true

    # Buffer images keep their download mtime when promoted, so the current
    # image can look "old" and get rotated out from under the logo symlink.
    current_target="$(readlink -f "$CURRENT_IMAGE" 2>/dev/null || true)"

    find "$CACHE_DIR" -maxdepth 1 -type f -name 'current-*.png' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn \
        | awk -v keep="$BUFFER_SIZE" 'NR > keep {print $2}' \
        | while IFS= read -r old_image; do
            if [[ -n "$current_target" && "$old_image" == "$current_target" ]]; then
                continue
            fi
            rm -f "$old_image" "${old_image%.*}.url" "${old_image%.*}.tags"
        done
}

clear_buffer() {
    if [[ -d "$BUFFER_DIR" ]]; then
        find "$BUFFER_DIR" -maxdepth 1 -type f \( -name '*.png' -o -name '*.url' -o -name '*.tags' \) -delete 2>/dev/null || true
    fi
}

buffer_count() {
    local count

    if [[ ! -d "$BUFFER_DIR" ]]; then
        printf '0\n'
        return 0
    fi

    count="$(find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -exec sh -c '
        count=0
        for image do
            [ -s "$image" ] && [ -s "${image%.*}.url" ] && count=$((count + 1))
        done
        printf "%s\n" "$count"
    ' sh {} + 2>/dev/null || true)"

    printf '%s\n' "${count:-0}"
}

# Keeps ~/.cache/fastfetch/waifus/logo.png (what config.jsonc points at) in
# sync with the current image. The rotating current.png symlink can go stale
# after cache rotation or a tag switch, and fastfetch silently falls back to
# the distro ASCII logo when its logo file is missing.
ensure_logo_image() {
    local target mode cols lines wanted

    target="$(readlink -f "$CURRENT_IMAGE" 2>/dev/null || true)"
    mode="$(logo_mode)"

    if [[ -z "$target" || ! -s "$target" ]]; then
        [[ -s "$LOGO_IMAGE" || -s "$LOGO_ANSI" ]]
        return
    fi

    # The promoted image keeps its download mtime, so comparing timestamps
    # misses new images: track the exact file plus the terminal geometry.
    if [[ "$mode" == "ansi" ]]; then
        read -r cols lines <<<"$(logo_geometry)"
        wanted="${target}|${cols}x${lines}"

        # A render can come out empty (bad decode, terminal with no size...).
        # Never trust one: require real content, otherwise redo it.
        ansi_positive() {
            [[ -s "$LOGO_ANSI" ]] &&
                [[ "$(wc -l < "$LOGO_ANSI" 2>/dev/null || printf '0')" -ge 3 ]] &&
                grep -q '38;2;' "$LOGO_ANSI" 2>/dev/null
        }

        if ! ansi_positive || [[ "$(cat "$LOGO_META" 2>/dev/null || true)" != "$wanted" ]]; then
            if render_ansi_logo "$target" "$LOGO_ANSI" "$cols" "$lines" && ansi_positive; then
                printf '%s\n' "$wanted" > "$LOGO_META" 2>/dev/null || true
            fi
        fi

        ansi_positive
        return
    fi

    if [[ ! -s "$LOGO_IMAGE" || "$(cat "$LOGO_META" 2>/dev/null || true)" != "$target" ]]; then
        cp -f "$target" "$LOGO_IMAGE" 2>/dev/null || true
        printf '%s\n' "$target" > "$LOGO_META" 2>/dev/null || true
    fi

    [[ -s "$LOGO_IMAGE" ]]
}

fill_buffer() {
    local count output url_output failures=0 attempts=0 filled=0 lock_fd
    local fill_limit="${WAIFUFETCH_FILL_LIMIT:-0}"
    [[ "$fill_limit" =~ ^[0-9]+$ ]] || fill_limit=0

    mkdir -p "$BUFFER_DIR"

    # The helper and the async refresh can overlap; one fill at a time.
    { exec {lock_fd}>"$CACHE_DIR/fill.lock"; } 2>/dev/null || return 0
    if ! flock -w 5 "$lock_fd" 2>/dev/null; then
        exec {lock_fd}>&-
        return 0
    fi

    # Interrupted downloads leave PNGs without their .url sidecar; they look
    # like cache to a naive count and stall the refill forever. Drop them.
    while IFS= read -r p; do
        [[ -s "${p%.*}.url" ]] || rm -f "$p"
    done < <(find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' 2>/dev/null || true)
    count="$(buffer_count)"
    count="${count:-0}"

    # A single failed download used to abort the whole refill, which left the
    # buffer empty for the next terminal. Retry a few times instead, and
    # recount every round so two concurrent fills cannot overshoot the size.
    while [[ "$failures" -lt 3 && "$attempts" -lt $((BUFFER_SIZE * 3)) ]]; do
        # .url files == valid pairs (each image gets one).
        count="$(find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.url' 2>/dev/null | wc -l)"
        count="${count:-0}"
        [[ "$count" -lt "$BUFFER_SIZE" ]] || break
        attempts=$((attempts + 1))

        output="$BUFFER_DIR/waifu-$(date +%s%N).png"
        url_output="${output%.*}.url"

        if ! download_waifu "$output" "$url_output"; then
            rm -f "$output" "$url_output"
            failures=$((failures + 1))
            continue
        fi

        failures=0
        filled=$((filled + 1))
        if (( fill_limit > 0 && filled >= fill_limit )); then
            break
        fi
    done

    mark_active_tags
    exec {lock_fd}>&-
    return 0
}

promote_file_as_current() {
    local image="$1"
    local url_file="${image%.*}.url"
    local tags_file="${image%.*}.tags"
    local unique unique_url unique_tags

    if [[ ! -s "$image" || ! -s "$url_file" ]]; then
        return 1
    fi

    unique="$CACHE_DIR/current-$(date +%s%N).png"
    unique_url="${unique%.*}.url"
    unique_tags="${unique%.*}.tags"
    mv "$image" "$unique"
    mv "$url_file" "$unique_url"
    if [[ -s "$tags_file" ]]; then
        mv "$tags_file" "$unique_tags"
    fi
    ln -sfn "$unique" "$CURRENT_IMAGE"
    cp -f "$unique" "$LOGO_IMAGE" 2>/dev/null || true
}

promote_buffer_image() {
    local image

    if [[ ! -d "$BUFFER_DIR" ]]; then
        return 1
    fi

    while IFS= read -r image; do
        if [[ -s "$image" && -s "${image%.*}.url" ]]; then
            promote_file_as_current "$image"
            return $?
        fi
    done < <(
        find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null \
            | sort -n \
            | awk '{print $2}' || true
    )

    return 1
}

refresh_buffer_async() {
    local lock_fd

    mkdir -p "$CACHE_DIR" "$BUFFER_DIR"

    if ! { exec {lock_fd}>"$LOCK_FILE"; } 2>/dev/null; then
        return 0
    fi

    (
        flock -n "$lock_fd" || exit 0
        fill_buffer
    ) >/dev/null 2>&1 &
    # Downloads must not compete with the terminal opening in the foreground.
    renice -n 10 -p "$!" >/dev/null 2>&1 || true
    exec {lock_fd}>&-
}

choose_logo() {
    if [[ -s "$CURRENT_IMAGE" ]]; then
        readlink -f "$CURRENT_IMAGE"
    elif [[ -s "$LOGO_IMAGE" ]]; then
        printf '%s\n' "$LOGO_IMAGE"
    else
        printf '%s\n' "$FALLBACK_IMAGE"
    fi
}

promote_next_image() {
    local unique unique_url unique_tags

    if [[ ! -s "$NEXT_IMAGE" || ! -s "$NEXT_URL" ]]; then
        return 1
    fi

    unique="$CACHE_DIR/current-$(date +%s%N).png"
    unique_url="${unique%.*}.url"
    unique_tags="${unique%.*}.tags"
    cp "$NEXT_IMAGE" "$unique"
    cp "$NEXT_URL" "$unique_url"
    if [[ -s "${NEXT_IMAGE%.*}.tags" ]]; then
        cp "${NEXT_IMAGE%.*}.tags" "$unique_tags"
    fi
    ln -sfn "$unique" "$CURRENT_IMAGE"
    cp -f "$unique" "$LOGO_IMAGE" 2>/dev/null || true
}

post_url_for_logo() {
    local logo="$1"
    local url_file="${logo%.*}.url"

    if [[ -s "$url_file" ]]; then
        cat "$url_file"
    fi
}

tags_for_logo() {
    local logo="$1"
    local tags_file="${logo%.*}.tags"
    local artist copyright characters

    fetch_tags_for_logo "$logo" >/dev/null 2>&1 || true

    if [[ ! -s "$tags_file" ]]; then
        printf 'artist: -\n'
        printf 'copyright: -\n'
        printf 'characters: -\n'
        return 0
    fi

    artist="$(jq -r '.artist // empty' "$tags_file")"
    copyright="$(jq -r '.copyright // empty' "$tags_file")"
    characters="$(jq -r '.characters // empty' "$tags_file")"

    if [[ -n "$artist" ]]; then
        tr ' ' '\n' <<<"$artist" | sed 's/^/artist: /'
    else
        printf 'artist: -\n'
    fi

    if [[ -n "$copyright" ]]; then
        tr ' ' '\n' <<<"$copyright" | sed 's/^/copyright: /'
    else
        printf 'copyright: -\n'
    fi

    if [[ -n "$characters" ]]; then
        tr ' ' '\n' <<<"$characters" | sed 's/^/characters: /'
    else
        printf 'characters: -\n'
    fi
}

tag_link() {
    local tag="$1"
    local label="${2:-$1}"
    local encoded

    if [[ -z "$tag" || "$tag" == "-" ]]; then
        printf '%s' "$tag"
        return 0
    fi

    encoded="$(jq -rn --arg tag "$tag" '$tag|@uri')"
    printf '\033]8;;waifufetch-tag://set?tag=%s\033\\%s\033]8;;\033\\' "$encoded" "$label"
}

tag_link_label() {
    local tag="$1"
    local label="$2"
    local encoded

    if [[ -z "$tag" || "$tag" == "-" ]]; then
        printf '%s' "$label"
        return 0
    fi

    encoded="$(jq -rn --arg tag "$tag" '$tag|@uri')"
    printf '\033]8;;waifufetch-tag://set?tag=%s\033\\%s\033]8;;\033\\' "$encoded" "$label"
}

fastfetch_text_column() {
    local width left right

    if [[ "${FASTFETCH_WAIFU_TEXT_COLUMN:-}" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$FASTFETCH_WAIFU_TEXT_COLUMN"
        return 0
    fi

    width="$(sed -nE 's/^[[:space:]]*"width"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" | head -n 1)"
    left="$(sed -nE 's/^[[:space:]]*"left"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" | head -n 1)"
    right="$(sed -nE 's/^[[:space:]]*"right"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$CONFIG_DIR/config.jsonc" | head -n 1)"

    if [[ "$width" =~ ^[0-9]+$ && "$left" =~ ^[0-9]+$ && "$right" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$((width + left + right))"
    else
        printf '37\n'
    fi
}

tags_for_fastfetch() {
    local line kind value label linked_value text_column first=1 tcols avail

    text_column="$(fastfetch_text_column)"
    read -r tcols _ < <(terminal_cells 2>/dev/null || printf '100 30\n')
    [[ "$tcols" =~ ^[0-9]+$ ]] || tcols=100
    # 17 = "| <icon> character| " plus a small right margin.
    avail=$((tcols - text_column - 17))
    (( avail < 12 )) && avail=12

    while IFS= read -r line; do
        kind="${line%%:*}"
        value="${line#*: }"
        # Only the label is shortened; the link keeps the whole tag.
        if (( ${#value} > avail )); then
            label="${value:0:$((avail - 1))}…"
        else
            label="$value"
        fi
        linked_value="$(tag_link "$value" "$label")"

        case "$kind" in
            artist)
                kind="artist   "
                ;;
            copyright)
                kind="copyright"
                ;;
            characters)
                kind="character"
                ;;
            *)
                kind="tag      "
                value="$line"
                ;;
        esac

        if [[ "$first" -eq 1 ]]; then
            printf '%s' "$linked_value"
            first=0
        else
            printf '\n\033[%sC│ \033[34m󰓹 %s\033[0m│ %s' "$text_column" "$kind" "$linked_value"
        fi
    done < <(
        if [[ -n "${FASTFETCH_WAIFU_TAGS:-}" ]]; then
            printf '%s\n' "$FASTFETCH_WAIFU_TAGS"
        else
            tags_for_logo "$(choose_logo)"
        fi
    )
}

open_source_url() {
    local logo url

    logo="$(choose_logo)"
    url="$(post_url_for_logo "$logo")"

    if [[ -z "$url" ]]; then
        printf 'No source URL available for current image.\n' >&2
        exit 1
    fi

    if command -v google-chrome-stable >/dev/null 2>&1; then
        nohup google-chrome-stable "$url" >/dev/null 2>&1 &
    elif command -v google-chrome >/dev/null 2>&1; then
        nohup google-chrome "$url" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        nohup xdg-open "$url" >/dev/null 2>&1 &
    elif command -v gio >/dev/null 2>&1; then
        nohup gio open "$url" >/dev/null 2>&1 &
    else
        printf 'No opener found. Install xdg-utils or open manually: %s\n' "$url" >&2
        exit 1
    fi
}

history_images() {
    local limit="$1"

    if [[ "$limit" == "all" ]]; then
        find "$CACHE_DIR" -maxdepth 1 -type f -name 'current-*.png' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn \
            | awk '{print $2}'
    else
        find "$CACHE_DIR" -maxdepth 1 -type f -name 'current-*.png' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn \
            | awk -v limit="$limit" 'NR <= limit {print $2}'
    fi
}

show_history_image() {
    local image="$1"
    local tmp

    if [[ ! -t 1 ]]; then
        printf 'image: %s\n' "$image"
        return 0
    fi

    if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1 && command -v magick >/dev/null 2>&1; then
        tmp="$(temp_png history-thumb)"
        magick "$image[0]" -auto-orient -resize '360x360>' "$tmp"
        kitten icat --align=left --scale-up=no --stdin=no --engine=builtin --transfer-mode=stream "$tmp" || true
        rm -f "$tmp"
    elif command -v img2sixel >/dev/null 2>&1 && command -v magick >/dev/null 2>&1; then
        tmp="$(temp_png history-thumb)"
        magick "$image[0]" -auto-orient -resize '360x360>' "$tmp"
        img2sixel "$tmp" || true
        rm -f "$tmp"
    elif command -v magick >/dev/null 2>&1 && command -v fastfetch >/dev/null 2>&1; then
        tmp="$(temp_png history-thumb)"
        magick "$image[0]" -auto-orient -resize '360x360>' "$tmp"
        show_ansi_image "$tmp" 36 || printf 'image: %s\n' "$image"
        rm -f "$tmp"
    else
        printf 'image: %s\n' "$image"
    fi
}

show_history_tags() {
    local image="$1"
    local tags_file="${image%.*}.tags"
    local kind tags tag

    fetch_tags_for_logo "$image" >/dev/null 2>&1 || true

    if [[ ! -s "$tags_file" ]]; then
        printf 'tags: -\n'
        return 0
    fi

    for kind in artist copyright characters; do
        tags="$(jq -r --arg kind "$kind" '.[$kind] // empty' "$tags_file")"
        [[ -n "$tags" ]] || continue

        printf '%s:' "$kind"
        while IFS= read -r tag; do
            printf ' %s' "$(tag_link "$tag")"
        done < <(tr ' ' '\n' <<<"$tags")
        printf '\n'
    done
}

show_history() {
    local limit="$1"
    local image url index=1 found=0

    if [[ "$limit" != "all" && ! "$limit" =~ ^[0-9]+$ ]]; then
        printf 'Invalid history count: %s\n' "$limit" >&2
        printf 'Use a number or all.\n' >&2
        exit 2
    fi

    while IFS= read -r image; do
        found=1
        url="$(post_url_for_logo "$image")"

        printf '\n\033[34m[%s]\033[0m %s\n' "$index" "$(basename "$image")"
        show_history_image "$image"
        show_history_tags "$image"
        if [[ -n "$url" ]]; then
            printf 'source: \033]8;;%s\033\\%s\033]8;;\033\\\n' "$url" "$url"
        else
            printf 'source: -\n'
        fi
        printf '%s\n' '────────────────────────────────────────'
        index=$((index + 1))
    done < <(history_images "$limit")

    if [[ "$found" -eq 0 ]]; then
        printf 'No waifufetch history found in %s.\n' "$CACHE_DIR" >&2
        exit 1
    fi
}

normalize_slide_delay() {
    local delay="$1"

    if [[ "$delay" =~ ^[0-9]+$ && "$delay" -ge "$MIN_SLIDE_DELAY" && "$delay" -le "$MAX_SLIDE_DELAY" ]]; then
        printf '%s\n' "$delay"
    else
        printf 'Invalid slide delay: %s\n' "$delay" >&2
        printf 'Use a number from %s to %s seconds.\n' "$MIN_SLIDE_DELAY" "$MAX_SLIDE_DELAY" >&2
        exit 2
    fi
}

slideshow_tag_links() {
    local tags="$1"
    local max="$2"
    local used=0
    local tag display output=""

    tags="$(sed 's/[[:space:]]\+/ /g; s/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$tags")"
    if [[ -z "$tags" ]]; then
        printf -- '-\n'
        return 0
    fi

    for tag in $tags; do
        display="$tag"
        if [[ "$used" -gt 0 ]]; then
            if [[ "$((used + 1 + ${#display}))" -gt "$max" ]]; then
                output="${output} ..."
                break
            fi
            output="${output} "
            used=$((used + 1))
        elif [[ "${#display}" -gt "$max" ]]; then
            display="${display:0:$((max - 3))}..."
            output="$(tag_link_label "$tag" "$display")"
            break
        fi

        output="${output}$(tag_link_label "$tag" "$display")"
        used=$((used + ${#display}))
    done

    printf '%s\n' "$output"
}

slideshow_status() {
    local image="$1"
    local delay="$2"
    local paused="$3"
    local url state artist copyright characters cols value_width

    url="$(post_url_for_logo "$image")"
    if [[ "$paused" -eq 1 ]]; then
        state="paused"
    else
        state="${delay}s"
    fi

    cols="$(tput cols 2>/dev/null || printf '80')"
    if [[ ! "$cols" =~ ^[0-9]+$ || "$cols" -lt 20 ]]; then
        cols=80
    fi
    value_width=$((cols - 14))
    if [[ "$value_width" -lt 10 ]]; then
        value_width=10
    fi

    fetch_tags_for_logo "$image" >/dev/null 2>&1 || true
    artist="$(slideshow_tag_links "$(jq -r '.artist // empty' "${image%.*}.tags" 2>/dev/null)" "$value_width")"
    copyright="$(slideshow_tag_links "$(jq -r '.copyright // empty' "${image%.*}.tags" 2>/dev/null)" "$value_width")"
    characters="$(slideshow_tag_links "$(jq -r '.characters // empty' "${image%.*}.tags" 2>/dev/null)" "$value_width")"

    printf '\033[1;1H\033[2K\033[34martist\033[0m: %s\n' "${artist:--}"
    printf '\033[2K\033[34mip\033[0m: %s\n' "${copyright:--}"
    printf '\033[2K\033[34mcharacters\033[0m: %s\n' "${characters:--}"
    printf '\033[2K[%s] space pause/resume | n next | +/- delay | o source | q quit\n' "$state"
    if [[ -n "$url" ]]; then
        printf '\033[2Ksource: \033]8;;%s\033\\source\033]8;;\033\\\n' "$url"
    fi
}

render_slideshow_image() {
    local image="$1"
    local delay="$2"
    local paused="$3"
    local cols lines image_top image_lines

    printf '\033[2J\033[H'
    slideshow_status "$image" "$delay" "$paused"

    if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1; then
        cols="$(tput cols 2>/dev/null || printf '80')"
        lines="$(tput lines 2>/dev/null || printf '24')"
        image_top=6
        image_lines=$((lines - image_top))
        if [[ "$image_lines" -lt 1 ]]; then
            image_lines=1
        fi

        kitten icat --clear --stdin=no >/dev/null 2>&1 || true
        kitten icat \
            --align=center \
            --place "${cols}x${image_lines}@0x${image_top}" \
            --scale-up=no \
            --stdin=no \
            --engine=builtin \
            --transfer-mode=stream \
            "$image" || printf 'image: %s\n' "$image"
    elif command -v img2sixel >/dev/null 2>&1; then
        img2sixel "$image" || printf 'image: %s\n' "$image"
    else
        show_ansi_image "$image" || printf 'image: %s\n' "$image"
    fi
}

slideshow_next_image() {
    if ! promote_buffer_image >/dev/null 2>&1; then
        if ! download_waifu "$NEXT_IMAGE" "$NEXT_URL"; then
            return 1
        fi
        if ! promote_next_image; then
            return 1
        fi
    fi

    cleanup_cache
    refresh_buffer_async
}

slideshow_cleanup() {
    if [[ -n "${SLIDESHOW_STTY:-}" ]]; then
        stty "$SLIDESHOW_STTY" 2>/dev/null || true
    fi

    if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1; then
        kitten icat --clear --stdin=no >/dev/null 2>&1 || true
    fi
    printf '\033[?25h\033[0m\n'
}

run_slideshow() {
    local delay="$1"
    local paused=0
    local remaining key logo

    delay="$(normalize_slide_delay "$delay")"

    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'Slideshow needs an interactive terminal.\n' >&2
        exit 1
    fi

    SLIDESHOW_STTY="$(stty -g)"
    trap slideshow_cleanup EXIT INT TERM
    stty -echo -icanon time 0 min 0
    printf '\033[?25l'

    if [[ ! -s "$CURRENT_IMAGE" ]]; then
        slideshow_next_image >/dev/null 2>&1 || true
    fi
    refresh_buffer_async

    while true; do
        logo="$(choose_logo)"
        render_slideshow_image "$logo" "$delay" "$paused"
        remaining="$delay"

        while [[ "$paused" -eq 1 || "$remaining" -gt 0 ]]; do
            if IFS= read -rsn1 -t 1 key; then
                case "$key" in
                    q|Q)
                        exit 0
                        ;;
                    ' ')
                        if [[ "$paused" -eq 1 ]]; then
                            paused=0
                            remaining="$delay"
                        else
                            paused=1
                        fi
                        render_slideshow_image "$logo" "$delay" "$paused"
                        ;;
                    n|N)
                        paused=0
                        break
                        ;;
                    +|=)
                        if [[ "$delay" -lt "$MAX_SLIDE_DELAY" ]]; then
                            delay=$((delay + 1))
                        fi
                        if [[ "$remaining" -gt "$delay" ]]; then
                            remaining="$delay"
                        fi
                        render_slideshow_image "$logo" "$delay" "$paused"
                        ;;
                    -|_)
                        if [[ "$delay" -gt "$MIN_SLIDE_DELAY" ]]; then
                            delay=$((delay - 1))
                        fi
                        if [[ "$remaining" -gt "$delay" ]]; then
                            remaining="$delay"
                        fi
                        render_slideshow_image "$logo" "$delay" "$paused"
                        ;;
                    o|O)
                        if [[ -n "$(post_url_for_logo "$logo")" ]]; then
                            open_source_url
                        fi
                        render_slideshow_image "$logo" "$delay" "$paused"
                        ;;
                esac
            elif [[ "$paused" -eq 0 ]]; then
                remaining=$((remaining - 1))
            fi
        done

        if ! slideshow_next_image; then
            sleep 2
        fi
    done
}

terminal_cells() {
    local cols lines

    # Outside a terminal (background helper) there is no size to query: reuse
    # the last one a real terminal reported, so the helper pre-renders the
    # escapes for the geometry that will actually be used.
    if [[ ! -t 1 && -s "$LAST_SIZE_FILE" ]]; then
        read -r cols lines < "$LAST_SIZE_FILE"
        if [[ "$cols" =~ ^[0-9]+$ && "$cols" -gt 0 && "$lines" =~ ^[0-9]+$ && "$lines" -gt 0 ]]; then
            printf '%s %s\n' "$cols" "$lines"
            return 0
        fi
    fi

    cols="$(tput cols 2>/dev/null || printf '80')"
    lines="$(tput lines 2>/dev/null || printf '24')"

    if [[ ! "$cols" =~ ^[0-9]+$ || "$cols" -lt 1 ]]; then
        cols=80
    fi
    if [[ ! "$lines" =~ ^[0-9]+$ || "$lines" -lt 1 ]]; then
        lines=24
    fi

    printf '%s %s\n' "$cols" "$lines"
}

terminal_pixels() {
    local cols="$1"
    local lines="$2"
    local size width height

    if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1 && [[ -t 1 ]]; then
        size="$(kitten icat --print-window-size --stdin=no 2>/dev/null || true)"
        width="${size%x*}"
        height="${size#*x}"
        if [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$width" -gt 0 && "$height" -gt 0 ]]; then
            printf '%s %s\n' "$width" "$height"
            return 0
        fi
    fi

    printf '%s %s\n' "$((cols * 10))" "$((lines * 20))"
}

normalize_collage_count() {
    local count="$1"

    if [[ "$count" =~ ^[0-9]+$ && "$count" -ge 1 && "$count" -le 100 ]]; then
        printf '%s\n' "$count"
    else
        printf 'Invalid collage count: %s\n' "$count" >&2
        printf 'Use a number from 1 to 100.\n' >&2
        exit 2
    fi
}

auto_collage_count() {
    local cols="$1"
    local lines="$2"
    local grid_cols grid_rows count

    grid_cols=$((cols / DEFAULT_COLLAGE_TILE_COLS))
    grid_rows=$((lines / DEFAULT_COLLAGE_TILE_LINES))
    if [[ "$grid_cols" -lt 1 ]]; then
        grid_cols=1
    fi
    if [[ "$grid_rows" -lt 1 ]]; then
        grid_rows=1
    fi

    count=$((grid_cols * grid_rows))
    if [[ "$count" -gt "$BUFFER_SIZE" ]]; then
        count="$BUFFER_SIZE"
    fi

    printf '%s\n' "$count"
}

collage_grid() {
    local count="$1"
    local cols="$2"
    local lines="$3"
    local grid_cols grid_rows

    grid_cols=$((cols / DEFAULT_COLLAGE_TILE_COLS))
    if [[ "$grid_cols" -lt 1 ]]; then
        grid_cols=1
    fi
    if [[ "$grid_cols" -gt "$count" ]]; then
        grid_cols="$count"
    fi

    grid_rows=$(((count + grid_cols - 1) / grid_cols))
    while [[ "$grid_rows" -gt 1 && "$((lines / grid_rows))" -lt 8 ]]; do
        grid_cols=$((grid_cols + 1))
        grid_rows=$(((count + grid_cols - 1) / grid_cols))
    done

    printf '%s %s\n' "$grid_cols" "$grid_rows"
}

collage_images() {
    local limit="$1"

    {
        if [[ -s "$CURRENT_IMAGE" ]]; then
            readlink -f "$CURRENT_IMAGE"
        fi
        history_images all
        if [[ -d "$BUFFER_DIR" ]]; then
            find "$BUFFER_DIR" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' 2>/dev/null \
                | sort -rn \
                | awk '{print $2}'
        fi
    } | awk '!seen[$0]++' | awk -v limit="$limit" 'NR <= limit {print}'
}

build_collage() {
    local count="$1"
    local cols lines width height grid_cols grid_rows tile_w tile_h output image
    local images=()

    if ! command -v magick >/dev/null 2>&1; then
        printf 'Collage needs ImageMagick: magick not found.\n' >&2
        exit 1
    fi

    read -r cols lines < <(terminal_cells)
    if [[ "$count" == "auto" ]]; then
        count="$(auto_collage_count "$cols" "$lines")"
    else
        count="$(normalize_collage_count "$count")"
    fi

    while IFS= read -r image; do
        [[ -s "$image" ]] || continue
        images+=("$image")
    done < <(collage_images "$count")

    if [[ "${#images[@]}" -eq 0 ]]; then
        if download_waifu "$NEXT_IMAGE" "$NEXT_URL" && promote_next_image; then
            images+=("$(choose_logo)")
        else
            printf 'No cached waifufetch images available for collage.\n' >&2
            exit 1
        fi
    fi

    count="${#images[@]}"
    read -r width height < <(terminal_pixels "$cols" "$lines")
    read -r grid_cols grid_rows < <(collage_grid "$count" "$cols" "$lines")

    tile_w=$((width / grid_cols))
    tile_h=$((height / grid_rows))
    if [[ "$tile_w" -lt 1 ]]; then
        tile_w=1
    fi
    if [[ "$tile_h" -lt 1 ]]; then
        tile_h=1
    fi

    output="$(temp_png collage)"
    if ! magick montage "${images[@]}" \
        -auto-orient \
        -thumbnail "${tile_w}x${tile_h}^" \
        -gravity center \
        -extent "${tile_w}x${tile_h}" \
        -tile "${grid_cols}x${grid_rows}" \
        -geometry "${tile_w}x${tile_h}+0+0" \
        -background black \
        "$output"; then
        rm -f "$output"
        printf 'Failed to build collage image.\n' >&2
        exit 1
    fi

    if [[ ! -s "$output" ]]; then
        rm -f "$output"
        printf 'Failed to build collage image: empty output.\n' >&2
        exit 1
    fi

    printf '%s\n' "$output"
}

show_collage() {
    local count="$1"
    local output cols lines

    mkdir -p "$CACHE_DIR"
    output="$(build_collage "$count")"

    if [[ -t 1 ]]; then
        printf '\033[2J\033[H\033[?25l'
        if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1; then
            read -r cols lines < <(terminal_cells)
            kitten icat --clear --stdin=no >/dev/null 2>&1 || true
            kitten icat \
                --align=center \
                --place "${cols}x${lines}@0x0" \
                --scale-up=no \
                --stdin=no \
                --engine=builtin \
                --transfer-mode=stream \
                "$output" || printf 'collage: %s\n' "$output"
        elif command -v img2sixel >/dev/null 2>&1; then
            img2sixel "$output" || printf 'collage: %s\n' "$output"
        else
            show_ansi_image "$output" || printf 'collage: %s\n' "$output"
        fi
        printf '\033[?25h\033[0m\n'
    else
        printf '%s\n' "$output"
    fi

    refresh_buffer_async
}

doctor() {
    local logo current_target target_img a b cfg_type cfg_source chafa_ok

    load_site
    load_auth

    printf 'waifufetch doctor\n\n'
    printf 'entorno\n'
    printf '  TERM=%s TERM_PROGRAM=%s COLORTERM=%s kitty=%s\n' \
        "${TERM:-?}" "${TERM_PROGRAM:-?}" "${COLORTERM:-?}" "${KITTY_WINDOW_ID:-no}"
    printf '  HOME=%s\n' "$HOME"
    printf '  config: %s\n' "$CONFIG_DIR"
    printf '  sitio: %s\n' "$BOORU_SITE"

    if [[ "$BOORU_SITE" == "gelbooru" ]]; then
        if [[ -n "${GELBOORU_API_KEY:-}" && -n "${GELBOORU_USER_ID:-}" ]]; then
            printf '  credenciales gelbooru: ok (user_id %s)\n' "$GELBOORU_USER_ID"
        else
            printf '  credenciales gelbooru: FALTAN en %s\n' "$GELBOORU_AUTH_FILE"
        fi
    fi

    printf '\nfastfetch\n'
    printf '  version: %s\n' "$(fastfetch --version 2>/dev/null | head -n 1)"
    chafa_ok="no"
    if fastfetch --list-features 2>/dev/null | tr ' ' '\n' | grep -qx chafa; then
        chafa_ok="si"
    fi
    printf '  soporte chafa: %s\n' "$chafa_ok"

    if [[ -f "$CONFIG_DIR/config.jsonc" ]]; then
        cfg_type="$(sed -nE 's/^[[:space:]]*"type"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$CONFIG_DIR/config.jsonc" | head -n 1)"
        cfg_source="$(sed -nE 's/^[[:space:]]*"source"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$CONFIG_DIR/config.jsonc" | head -n 1)"
        printf '  config.jsonc: logo type=%s source=%s\n' "${cfg_type:--}" "${cfg_source:--}"
    else
        printf '  config.jsonc: FALTA (%s)\n' "$CONFIG_DIR/config.jsonc"
    fi

    ensure_logo_image || true

    printf '\nimagenes\n'
    printf '  buffer: %s/%s\n' "$(buffer_count)" "$BUFFER_SIZE"

    current_target="$(readlink -f "$CURRENT_IMAGE" 2>/dev/null || true)"
    if [[ -n "$current_target" && -s "$current_target" ]]; then
        printf '  current.png: ok -> %s (%s)\n' \
            "$(basename "$current_target")" \
            "$(magick identify -format '%wx%h' "$current_target[0]" 2>/dev/null || echo '?')"
    else
        printf '  current.png: ROTO (apunta a %s)\n' "${current_target:-nada}"
    fi

    if [[ "$(logo_mode)" == "chafa" ]]; then
        if [[ -s "$LOGO_IMAGE" ]]; then
            printf '  logo.png: ok (%s)\n' "$(magick identify -format '%wx%h' "$LOGO_IMAGE[0]" 2>/dev/null || echo '?')"
        else
            printf '  logo.png: FALTA\n'
        fi
    fi

    logo="$(choose_logo)"
    printf '  logo elegido: %s\n' "${logo:-(ninguno)}"

    printf '\nrender\n'
    mode="$(logo_mode)"
    printf '  modo de logo: %s (auto -> graphics en kitty, ansi si no)\n' "$mode"

    if [[ "$mode" == "ansi" ]]; then
        if [[ -s "$LOGO_ANSI" ]] && grep -q '38;2;' "$LOGO_ANSI" 2>/dev/null; then
            printf '  logo ANSI: OK (%s lineas, %s KB, color 24-bit)\n' \
                "$(wc -l < "$LOGO_ANSI")" "$(( $(wc -c < "$LOGO_ANSI") / 1024 ))"
            printf '  geometria: %s (cols x lineas maximas para este terminal)\n' "$(logo_geometry)"
        else
            printf '  logo ANSI: FALLA (no se pudo generar)\n'
        fi
    elif [[ "$mode" == "graphics" ]]; then
        if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
            printf '  terminal kitty: OK (protocolo grafico disponible)\n'
        else
            printf '  terminal kitty: NO -> no se puede dibujar en pixeles\n'
        fi
    else
        if fastfetch --list-features 2>/dev/null | tr ' ' '\n' | grep -qx chafa; then
            printf '  chafa compilado en fastfetch: si\n'
        else
            printf '  chafa compilado en fastfetch: NO\n'
        fi
        if ldconfig -p 2>/dev/null | grep -q 'libchafa\.so'; then
            printf '  libchafa instalada: si\n'
        else
            printf '  libchafa instalada: NO -> fastfetch pinta el ASCII de la distro\n'
        fi
    fi

    if [[ "$mode" == "ansi" ]]; then
        if [[ -t 1 ]]; then
            printf '  TTY: si\n'
        else
            printf '  TTY: NO (el logo ANSI se dibuja igual, pero fastfetch recorta el layout)\n'
        fi
    fi

    printf '\nArreglo rapido: waifufetch --prefetch-buffer && waifufetch\n'
}

TAG_OVERRIDE=""
RATING_OVERRIDE=""
RATING_OVERRIDE_SET=0
BUFFER_SIZE_OVERRIDE=""
REFRESH_ONLY=0
SHOW_SLIDESHOW=0
SLIDE_DELAY="$DEFAULT_SLIDE_DELAY"
SHOW_COLLAGE=0
COLLAGE_COUNT="auto"
PRINT_IMAGE=0
PRINT_BUFFER_COUNT=0
PRINT_IMAGE_TAGS=0
PRINT_IMAGE_TAGS_FASTFETCH=0
OPEN_SOURCE=0
DOCTOR=0
ENSURE_LOGO=0
PREPARE_ESCAPES=0
PREPARE_NEXT=0
MAINTAIN_CACHE=0
HELPER_ACTION=""
SHOW_HISTORY=0
HISTORY_LIMIT=10
TAGS_CHANGED=0
BUFFER_SIZE_CHANGED=0
FORCED_REFRESH=0
FASTFETCH_ARGS=()
BUFFER_SIZE="$(read_buffer_size)"
FASTFETCH_WAIFU_BUFFER=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --refresh-only|--prefetch-buffer)
            REFRESH_ONLY=1
            shift
            ;;
        --slideshow)
            SHOW_SLIDESHOW=1
            shift
            ;;
        --collage)
            SHOW_COLLAGE=1
            if [[ -n "${2:-}" && "$2" != -* ]]; then
                COLLAGE_COUNT="$2"
                shift 2
            else
                shift
            fi
            ;;
        --collage=*)
            SHOW_COLLAGE=1
            COLLAGE_COUNT="${1#*=}"
            shift
            ;;
        --slide-delay)
            if [[ -z "${2:-}" ]]; then
                printf '%s requires a value\n' "$1" >&2
                exit 2
            fi
            SLIDE_DELAY="$2"
            shift 2
            ;;
        --slide-delay=*)
            SLIDE_DELAY="${1#*=}"
            shift
            ;;
        --buffer-size)
            if [[ -z "${2:-}" ]]; then
                printf '%s requires a value\n' "$1" >&2
                exit 2
            fi
            BUFFER_SIZE_OVERRIDE="$2"
            BUFFER_SIZE_CHANGED=1
            shift 2
            ;;
        --buffer-size=*)
            BUFFER_SIZE_OVERRIDE="${1#*=}"
            BUFFER_SIZE_CHANGED=1
            shift
            ;;
        --print-image)
            PRINT_IMAGE=1
            shift
            ;;
        --buffer-count)
            PRINT_BUFFER_COUNT=1
            shift
            ;;
        --image-tags)
            PRINT_IMAGE_TAGS=1
            shift
            ;;
        --image-tags-fastfetch)
            PRINT_IMAGE_TAGS_FASTFETCH=1
            shift
            ;;
        --doctor)
            DOCTOR=1
            shift
            ;;
        --ensure-logo)
            ENSURE_LOGO=1
            shift
            ;;
        --maintain-cache)
            MAINTAIN_CACHE=1
            shift
            ;;
        --prepare-next)
            PREPARE_NEXT=1
            shift
            ;;
        --prepare-escapes)
            PREPARE_ESCAPES=1
            shift
            if [[ -n "${1:-}" && "$1" =~ ^[0-9]+$ ]]; then
                PREPARE_ESCAPES="$1"
                shift
            fi
            ;;
        --helper-start)
            HELPER_ACTION=start
            shift
            ;;
        --helper-stop)
            HELPER_ACTION=stop
            shift
            ;;
        --helper-status)
            HELPER_ACTION=status
            shift
            ;;
        --open-source)
            OPEN_SOURCE=1
            shift
            ;;
        --history)
            SHOW_HISTORY=1
            if [[ -n "${2:-}" && "$2" != -* ]]; then
                HISTORY_LIMIT="$2"
                shift 2
            else
                shift
            fi
            ;;
        --history=*)
            SHOW_HISTORY=1
            HISTORY_LIMIT="${1#*=}"
            shift
            ;;
        -t|--tag|--tags)
            if [[ -z "${2:-}" ]]; then
                printf '%s requires a value\n' "$1" >&2
                exit 2
            fi
            TAG_OVERRIDE="${TAG_OVERRIDE:+$TAG_OVERRIDE }$2"
            TAGS_CHANGED=1
            shift 2
            ;;
        --tag=*|--tags=*)
            TAG_OVERRIDE="${TAG_OVERRIDE:+$TAG_OVERRIDE }${1#*=}"
            TAGS_CHANGED=1
            shift
            ;;
        -r|--rating)
            if [[ "$#" -lt 2 ]]; then
                printf '%s requires a value\n' "$1" >&2
                exit 2
            fi
            RATING_OVERRIDE="$2"
            RATING_OVERRIDE_SET=1
            TAGS_CHANGED=1
            shift 2
            ;;
        --rating=*)
            RATING_OVERRIDE="${1#*=}"
            RATING_OVERRIDE_SET=1
            TAGS_CHANGED=1
            shift
            ;;
        --)
            shift
            FASTFETCH_ARGS+=("$@")
            break
            ;;
        *)
            FASTFETCH_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ "$SHOW_COLLAGE" -eq 1 && "$COLLAGE_COUNT" != "auto" ]]; then
    COLLAGE_COUNT="$(normalize_collage_count "$COLLAGE_COUNT")"
fi

if [[ "$BUFFER_SIZE_CHANGED" -eq 1 ]]; then
    save_buffer_size "$BUFFER_SIZE_OVERRIDE"
    cleanup_cache
    if [[ "$REFRESH_ONLY" -eq 0 && "$SHOW_SLIDESHOW" -eq 0 && "$SHOW_COLLAGE" -eq 0 && "$TAGS_CHANGED" -eq 0 && "${#FASTFETCH_ARGS[@]}" -eq 0 ]]; then
        printf 'Buffer size set to %s. History limit set to %s.\n' "$BUFFER_SIZE" "$BUFFER_SIZE"
        exit 0
    fi
fi

if [[ "$PRINT_IMAGE" -eq 1 ]]; then
    printf '%s\n' "$(choose_logo)"
    exit 0
fi

if [[ "$PRINT_BUFFER_COUNT" -eq 1 ]]; then
    printf '%s/%s\n' "$(buffer_count)" "$BUFFER_SIZE"
    exit 0
fi

if [[ "$PRINT_IMAGE_TAGS" -eq 1 ]]; then
    tags_for_logo "$(choose_logo)"
    exit 0
fi

if [[ "$PRINT_IMAGE_TAGS_FASTFETCH" -eq 1 ]]; then
    tags_for_fastfetch
    exit 0
fi

if [[ "$HELPER_ACTION" == "start" ]]; then
    start_helper
    exit 0
fi

if [[ "$HELPER_ACTION" == "stop" ]]; then
    stop_helper
    exit 0
fi

if [[ "$HELPER_ACTION" == "status" ]]; then
    if helper_running; then printf 'helper: corriendo\n'; else printf 'helper: parado\n'; fi
    exit 0
fi

if [[ "$MAINTAIN_CACHE" -eq 1 ]]; then
    maintain_cache
    exit 0
fi

if [[ "$PREPARE_NEXT" -eq 1 ]]; then
    prepare_next_banner || exit 1
    exit 0
fi

if [[ "$PREPARE_ESCAPES" != "0" ]]; then
    prepare_escapes "$PREPARE_ESCAPES"
    exit 0
fi

if [[ "$ENSURE_LOGO" -eq 1 ]]; then
    ensure_logo_image || true
    source_image="$(choose_logo)"
    export FASTFETCH_WAIFU_TAGS="$(tags_for_logo "$source_image")"
    export FASTFETCH_WAIFU_SOURCE="$(post_url_for_logo "$source_image")"
    if [[ -s "$LOGO_ANSI" ]]; then
        read -r pad_left _ pad_right < <(logo_padding)
        logo_w="$(cat "$LOGO_ANSI.width" 2>/dev/null || true)"
        [[ "$logo_w" =~ ^[0-9]+$ ]] || logo_w="$(logo_columns)"
        export FASTFETCH_WAIFU_TEXT_COLUMN="$(text_column_for_width "$logo_w")"
    fi
    write_banner_files
    exit 0
fi

if [[ "$DOCTOR" -eq 1 ]]; then
    doctor
    exit 0
fi

if [[ "$OPEN_SOURCE" -eq 1 ]]; then
    open_source_url
    exit 0
fi

if [[ "$SHOW_HISTORY" -eq 1 ]]; then
    show_history "$HISTORY_LIMIT"
    exit 0
fi

if [[ "$TAGS_CHANGED" -eq 0 ]] && tags_config_changed; then
    clear_buffer
    if [[ "$REFRESH_ONLY" -eq 0 ]]; then
        if download_waifu "$NEXT_IMAGE" "$NEXT_URL" && promote_next_image; then
            mark_active_tags
            FORCED_REFRESH=1
        else
            warn_fetch_failed
        fi
    fi
fi

if [[ "$TAGS_CHANGED" -eq 1 ]]; then
    save_tags
    TAG_OVERRIDE=""
    RATING_OVERRIDE=""
    RATING_OVERRIDE_SET=0
    clear_buffer
    if download_waifu "$NEXT_IMAGE" "$NEXT_URL" && promote_next_image; then
        mark_active_tags
        FORCED_REFRESH=1
    else
        warn_fetch_failed
    fi
fi

if [[ "$REFRESH_ONLY" -eq 1 ]]; then
    fill_buffer || true
    exit 0
fi

if [[ "$SHOW_COLLAGE" -eq 1 ]]; then
    show_collage "$COLLAGE_COUNT"
    exit 0
fi

if [[ ! -s "$CURRENT_IMAGE" && "$FORCED_REFRESH" -eq 1 ]]; then
    download_waifu "$NEXT_IMAGE" "$NEXT_URL" >/dev/null 2>&1 || true
    promote_next_image >/dev/null 2>&1 || true
fi

if [[ "$FORCED_REFRESH" -eq 0 ]]; then
    prune_buffer
    FASTFETCH_WAIFU_BUFFER="$(buffer_count)/$BUFFER_SIZE"
    if [[ "$SHOW_SLIDESHOW" -eq 0 && "$SHOW_COLLAGE" -eq 0 ]]; then
        promote_buffer_image >/dev/null 2>&1 || true
        cleanup_cache
        refresh_buffer_async
    fi
fi

if [[ "$SHOW_SLIDESHOW" -eq 1 ]]; then
    run_slideshow "$SLIDE_DELAY"
    exit 0
fi

record_terminal_size
source_image="$(choose_logo)"
LOGO_MODE_ACTIVE="$(logo_mode)"

# The tag rows are the widest module lines, so the logo width has to leave
# room for them; compute that before any geometry is decided.
tag_text="$(tags_for_logo "$source_image")"
export FASTFETCH_WAIFU_SOURCE="$(post_url_for_logo "$source_image")"
export FASTFETCH_WAIFU_BUFFER="${FASTFETCH_WAIFU_BUFFER:-$(buffer_count)/$BUFFER_SIZE}"
export FASTFETCH_WAIFU_TAGS="$tag_text"
LOGO_MAX_COLS="$(tag_width_cap "$tag_text")"

if [[ "$LOGO_MODE_ACTIVE" == "graphics" && -s "$source_image" && -t 1 ]]; then
    if graphics_banner "$source_image"; then
        prefetch_escape_async
        exit 0
    fi
    # fall through to the ANSI renderer if kitty could not draw the image
fi

ensure_logo_image || true

if [[ "$LOGO_MODE_ACTIVE" == "ansi" && -s "$LOGO_ANSI" ]]; then
    logo="$LOGO_ANSI"
    LOGO_ARGS=(--logo "$LOGO_ANSI" --logo-type file-raw)
elif [[ -s "$source_image" && -r "$source_image" ]]; then
    logo="$source_image"
    LOGO_ARGS=(--logo "$logo")
else
    warn_fetch_failed
    LOGO_ARGS=(--logo none)
fi

if [[ "$LOGO_MODE_ACTIVE" != "graphics" ]] && [[ -s "$LOGO_ANSI" ]]; then
    read -r pad_left _ pad_right < <(logo_padding)
    logo_w="$(cat "$LOGO_ANSI.width" 2>/dev/null || true)"
    [[ "$logo_w" =~ ^[0-9]+$ ]] || logo_w="$(logo_columns)"
    export FASTFETCH_WAIFU_TEXT_COLUMN="$(text_column_for_width "$logo_w")"
fi
write_banner_files
fastfetch "${LOGO_ARGS[@]}" "${FASTFETCH_ARGS[@]}"
status=$?

if [[ "$FORCED_REFRESH" -eq 1 ]]; then
    refresh_buffer_async
fi
exit "$status"

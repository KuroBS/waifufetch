#!/usr/bin/env bash

# Background helper for waifufetch.
#
# Keeps a queue of ready-to-paint banners (image picked, kitty escape
# rendered, tag rows resolved) and keeps the image buffer full. The fast
# painter (waifufetch-paint) only prints fastfetch and cats files, so opening
# a terminal does almost no work.
#
# Started on demand by the shell greeting; a lock file prevents duplicates.

set -uo pipefail

cache_dir="$HOME/.cache/fastfetch/waifus"
lock="$cache_dir/helper.lock"
pidfile="$cache_dir/helper.lock.pid"
waifu="$HOME/.local/bin/waifufetch"
queue="$cache_dir/paint.queue"
target="${WAIFUFETCH_QUEUE_TARGET:-6}"

mkdir -p "$cache_dir" 2>/dev/null || true

exec 9>>"$lock" || exit 0
if ! flock -n 9; then
    exit 0                      # another helper is already running
fi

printf '%s\n' "$$" > "$pidfile" 2>/dev/null || true
trap 'rm -f "$pidfile"; exit 0' INT TERM
trap 'rm -f "$pidfile"' EXIT

# This must never compete with the terminal opening.
renice -n 10 -p "$$" >/dev/null 2>&1 || true

while :; do
    if [[ -x "$waifu" ]]; then
        ready="$(find "$queue" -maxdepth 1 -type f -name '*.state' 2>/dev/null | wc -l)"
        ready="${ready:-0}"
        bufsz="$(find "$cache_dir/buffer" -maxdepth 1 -type f -name '*.png' 2>/dev/null | wc -l)"
        bufsz="${bufsz:-0}"
        if (( ready < target )); then
            if (( bufsz < 4 )); then
                # Buffer too thin to feed the queue: refill a few images first
                # so every queue entry does not wait for its own download.
                WAIFUFETCH_FILL_LIMIT=3 "$waifu" --prefetch-buffer >/dev/null 2>&1 || true
                sleep 1
                continue
            fi
            WAIFUFETCH_LOGO_MODE=graphics "$waifu" --prepare-next >/dev/null 2>&1 || true
            sleep 1
            continue
        fi
        # Keep the ANSI fallback (alacritty and friends) fresh too.
        "$waifu" --ensure-logo >/dev/null 2>&1 || true
        WAIFUFETCH_FILL_LIMIT=1 "$waifu" --prefetch-buffer >/dev/null 2>&1 || true
    fi
    sleep 8
done

#!/usr/bin/env bash

# Greeting wrapper: draws the banner as fast as possible.
#
# Inside kitty the picture is drawn with the kitty protocol; waifufetch reads
# the escape from the cache the background helper prepares, so an open is
# basically fastfetch plus a cat. Outside kitty it falls back to the ANSI
# blocks (or whatever LOGO_MODE says).
#
# The helper is started (detached) so the next open is already prepared.

set -uo pipefail

waifu="$HOME/.local/bin/waifufetch"
paint="$HOME/.local/bin/waifufetch-paint"
helper="$HOME/.local/bin/waifufetch-helper"

# Start the background helper once; it is a no-op when it is already running.
if [[ -x "$helper" ]]; then
    if command -v setsid >/dev/null 2>&1; then
        setsid "$helper" >/dev/null 2>&1 </dev/null &
    else
        nohup "$helper" >/dev/null 2>&1 </dev/null &
    fi
fi

if [[ ! -x "$waifu" ]]; then
    exec fastfetch "$@"
fi

if [[ -x "$paint" ]]; then
    exec "$paint" "$@"
fi

exec "$waifu" "$@"

#!/usr/bin/env bash

# Greeting wrapper: the ONLY thing an opening terminal runs is the fast
# painter. The helper (buffer + ready banners) is started once per session
# from the compositor autostart, never from here.

set -uo pipefail

paint="$HOME/.local/bin/waifufetch-paint"

if [[ -x "$paint" ]]; then
    exec "$paint" "$@"
fi

exec fastfetch "$@"
